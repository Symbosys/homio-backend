// =============================================================================
// HOMIO CRM MARKETPLACE ENUMS
// =============================================================================

enum ProductType {
  DIGITAL_ASSET
  HOME_DECOR
  PROPERTIES
  MATERIALS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductOwnershipType {
  SELF_OWNED
  VENDOR_OWNED
}

enum PropertyVerificationStatus {
  DRAFT
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum PropertyType {
  APARTMENT
  PENTHOUSE
  BUILDER_FLOOR
  VILLA
  COMMERCIAL
  PLOT
  OTHER
}

enum ListingIntent {
  SALE
  RENT
  LEASE
}

// =============================================================================
// VENDOR / SUPPLIER MANAGEMENT
// =============================================================================

model Vendor {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationVendors", fields: [organizationId], references: [id], onDelete: Cascade)

  code                  String?  @map("code")
  name                  String   @map("name")
  companyName           String?  @map("company_name")
  category              String?  @map("category") // e.g. "TILES", "TIMBER", "ELECTRICAL", "FABRICATION", "CONTRACTOR", "SERVICES"
  contactPerson         String?  @map("contact_person")
  email                 String?  @map("email")
  phone                 String?  @map("phone")
  alternatePhone        String?  @map("alternate_phone")
  website               String?  @map("website")
  address               String?  @map("address")
  city                  String?  @map("city")
  state                 String?  @map("state")
  country               String   @default("IN") @map("country")
  pincode               String?  @map("pincode")
  gstin                 String?  @map("gstin")
  panNumber             String?  @map("pan_number")
  bankName              String?  @map("bank_name")
  bankAccountNumber     String?  @map("bank_account_number")
  bankIfscCode          String?  @map("bank_ifsc_code")
  bankBranch            String?  @map("bank_branch")
  paymentTermsDays      Int?     @default(30) @map("payment_terms_days")
  defaultCommissionRate Decimal? @map("default_commission_rate") @db.Decimal(5, 2) // Default % owner gets on product sale
  rating                Float?   @map("rating")
  notes                 String?  @map("notes") @db.Text
  isActive              Boolean  @default(true) @map("is_active")

  // Associated Relations
  products   Product[]          @relation("VendorProducts")
  expenses   Expense[]          @relation("VendorExpenses")
  rfqInvites VendorRfqInvite[]  @relation("VendorRfqInvites")
  quotations VendorQuotation[]  @relation("VendorQuotations")
  dispatches MaterialDispatch[] @relation("VendorDispatches")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([category])
  @@index([isDeleted, deletedAt])
  @@map("vendors")
}

// =============================================================================
// 1. CORE UNIFIED PRODUCT TABLE
// =============================================================================

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationProducts", fields: [organizationId], references: [id], onDelete: Cascade)

  // Core Identifiers & Metadata
  name        String      @map("name")
  slug        String      @map("slug")
  sku         String?     @map("sku")
  type        ProductType @map("type")
  description String?     @map("description") @db.Text
  tags        String[]    @default([]) @map("tags")

  // Media (Multi-Cloud Structured JSON ImageType Standard)
  coverImageUrl Json? @map("cover_image_url") // Structured ImageType { id, url, bytes, format, provider }
  images        Json? @map("images")          // Array of ImageType

  // Ownership & Vendor Sourcing
  ownershipType ProductOwnershipType @default(SELF_OWNED) @map("ownership_type")
  vendorId      String?              @map("vendor_id") @db.Uuid
  vendor        Vendor?              @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: SetNull)

  // Universal Pricing & Taxation
  currency        String   @default("INR") @map("currency")
  mrp             Decimal  @default(0) @map("mrp") @db.Decimal(14, 2)
  sellingPrice    Decimal  @default(0) @map("selling_price") @db.Decimal(14, 2)
  costPrice       Decimal? @default(0) @map("cost_price") @db.Decimal(14, 2)
  taxRate         Decimal  @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  isTaxInclusive  Boolean  @default(false) @map("is_tax_inclusive")
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)

  // Universal Stock, Inventory & Measurement
  unit             String? @default("piece") @map("unit") // e.g. "piece", "sq.ft", "kg", "box", "ton", "sheet"
  inStock          Boolean @default(true) @map("in_stock")
  stockQuantity    Int     @default(0) @map("stock_quantity")
  minOrderQuantity Int     @default(1) @map("min_order_quantity")
  lowStockAlert    Int     @default(5) @map("low_stock_alert")

  // Ratings & Telemetry
  rating       Decimal @default(0.0) @map("rating") @db.Decimal(3, 2)
  reviewsCount Int     @default(0) @map("reviews_count")
  totalSales   Int     @default(0) @map("total_sales")

  // Publishing & Visibility
  status      ProductStatus @default(DRAFT) @map("status")
  isFeatured  Boolean       @default(false) @map("is_featured")
  isPublished Boolean       @default(false) @map("is_published")

  // Universal Additional Information JSON
  additionalInformation Json? @map("additional_information")

  // Audit Information
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?     @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // 1-to-1 Type Specific Extension Relations
  digitalDetails   DigitalProductDetails?   @relation("ProductDigitalDetails")
  homeDecorDetails HomeDecorProductDetails? @relation("ProductHomeDecorDetails")
  propertyDetails  PropertyListingDetails?  @relation("ProductPropertyDetails")
  materialDetails  MaterialProductDetails?  @relation("ProductMaterialDetails")

  // Procurement Module Relations
  materialRequestItems MaterialRequestItem[]  @relation("ProductMaterialRequestItems")
  rfqItems             VendorRfqItem[]        @relation("ProductRfqItems")
  quotationItems       VendorQuotationItem[]  @relation("ProductQuotationItems")
  dispatchItems        MaterialDispatchItem[] @relation("ProductDispatchItems")

  @@unique([organizationId, slug])
  @@unique([organizationId, sku])
  @@index([organizationId, type, status])
  @@index([organizationId, ownershipType])
  @@index([vendorId])
  @@index([isDeleted, deletedAt])
  @@map("products")
}

// =============================================================================
// 2. 1-to-1 TYPE EXTENSION: DIGITAL ASSET DETAILS
// =============================================================================

model DigitalProductDetails {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @unique @map("product_id") @db.Uuid
  product   Product @relation("ProductDigitalDetails", fields: [productId], references: [id], onDelete: Cascade)

  // File Delivery & Specifications
  fileUrl            String  @map("file_url")
  fileFormat         String  @map("file_format") // e.g. "PDF", "DWG", "RVT", "SKP", "ZIP", "OBJ", "FBX"
  fileSize           String? @map("file_size")   // e.g. "45.8 MB"
  previewImages      Json?   @map("preview_images")
  authorName         String? @map("author_name")
  version            String? @default("1.0.0") @map("version")
  compatibleSoftware String? @map("compatible_software") // e.g. "AutoCAD 2024+, Revit 2023, SketchUp"
  licenseType        String? @default("Standard Commercial") @map("license_type")

  // Access Security & Limits
  downloadLinkExpiryHours Int @default(48) @map("download_link_expiry_hours")
  maxDownloads            Int @default(5) @map("max_downloads")

  // Custom Extension Attributes
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("digital_product_details")
}

// =============================================================================
// 3. 1-to-1 TYPE EXTENSION: HOME DECOR DETAILS
// =============================================================================

model HomeDecorProductDetails {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @unique @map("product_id") @db.Uuid
  product   Product @relation("ProductHomeDecorDetails", fields: [productId], references: [id], onDelete: Cascade)

  // Brand & Material Specifications
  brandName        String? @map("brand_name")
  material         String? @map("material")          // e.g. "Teak Wood", "Velvet Fabric", "Brass", "Ceramic"
  color            String? @map("color")             // e.g. "Emerald Green / Gold"
  dimensions       String? @map("dimensions")        // e.g. "L: 210cm x W: 90cm x H: 85cm"
  roomType         String? @map("room_type")         // e.g. "Living Room", "Bedroom", "Dining"
  style            String? @map("style")             // e.g. "Mid-Century Modern", "Minimalist", "Boho"
  assemblyRequired Boolean @default(false) @map("assembly_required")
  careInstructions String? @map("care_instructions") @db.Text

  // Samples & Logistics
  sampleAvailable Boolean  @default(false) @map("sample_available")
  samplePrice     Decimal? @default(0) @map("sample_price") @db.Decimal(12, 2)
  leadTimeDays    Int?     @default(5) @map("lead_time_days")

  // Custom Extension Attributes
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("home_decor_product_details")
}

// =============================================================================
// 4. 1-to-1 TYPE EXTENSION: PROPERTY LISTING DETAILS
// =============================================================================

model PropertyListingDetails {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @unique @map("product_id") @db.Uuid
  product   Product @relation("ProductPropertyDetails", fields: [productId], references: [id], onDelete: Cascade)

  // Property Classification
  propertyType       PropertyType               @default(APARTMENT) @map("property_type")
  intent             ListingIntent              @default(SALE) @map("intent")
  verificationStatus PropertyVerificationStatus @default(DRAFT) @map("verification_status")

  // Layout & Spatial Specs
  bhk                 String    @map("bhk")               // e.g. "3 BHK", "4 BHK Penthouse"
  bedrooms            Int       @map("bedrooms")
  bathrooms           Int       @map("bathrooms")
  balconies           Int       @default(0) @map("balconies")
  carpetAreaSqft      Int       @map("carpet_area_sqft")
  superBuiltUpSqft    Int?      @map("super_built_up_sqft")
  floorNumber         Int?      @map("floor_number")
  totalFloors         Int?      @map("total_floors")
  furnishingStatus    String    @default("Unfurnished") @map("furnishing_status") // "Unfurnished", "Semi-Furnished", "Fully Furnished"
  coveredParkingSlots Int       @default(0) @map("covered_parking_slots")
  availableFrom       DateTime? @map("available_from")
  reraRegistration    String?   @map("rera_registration")

  // Financials & Negotiation
  maintenanceMonthly Decimal @default(0) @map("maintenance_monthly") @db.Decimal(12, 2)
  isNegotiable       Boolean @default(true) @map("is_negotiable")

  // Monetization & Contact Unlocks
  contactUnlockFee          Decimal @default(500) @map("contact_unlock_fee") @db.Decimal(10, 2)
  contactUnlockDurationDays Int     @default(30) @map("contact_unlock_duration_days")
  totalContactUnlocks       Int     @default(0) @map("total_contact_unlocks")

  // Owner / Developer Contact (Unlocked after lead or purchase)
  ownerName  String  @map("owner_name")
  ownerPhone String  @map("owner_phone")
  ownerEmail String? @map("owner_email")

  // Location & Geocoding
  addressLine String?  @map("address_line")
  locality    String   @map("locality")
  city        String   @map("city")
  state       String   @map("state")
  pinCode     String?  @map("pin_code")
  latitude    Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude   Decimal? @map("longitude") @db.Decimal(10, 7)

  // Amenities & Custom Extension Attributes
  amenities             String[] @default([]) @map("amenities")
  additionalInformation Json?    @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([city, locality])
  @@index([propertyType, intent])
  @@map("property_listing_details")
}

// =============================================================================
// 5. 1-to-1 TYPE EXTENSION: WHOLESALE MATERIAL DETAILS
// =============================================================================

model MaterialProductDetails {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @unique @map("product_id") @db.Uuid
  product   Product @relation("ProductMaterialDetails", fields: [productId], references: [id], onDelete: Cascade)

  // Specifications
  brandName       String? @map("brand_name")
  materialType    String? @map("material_type")     // e.g. "Italian Marble", "Plywood BWP", "Vitrified Tile"
  grade           String? @map("grade")             // e.g. "Commercial Grade A", "IS 710", "FE 550D"
  dimensions      String? @map("dimensions")        // e.g. "8ft x 4ft x 18mm", "600mm x 1200mm"
  thickness       String? @map("thickness")         // e.g. "18mm", "12mm", "20mm"
  application     String? @map("application")       // e.g. "Flooring", "Wet Areas", "Structural"
  coveragePerUnit String? @map("coverage_per_unit") // e.g. "32 sq.ft per sheet", "15.5 sq.ft per box"
  warrantyYears   Int?    @default(0) @map("warranty_years")
  technicalDocUrl String? @map("technical_doc_url")

  // Procurement & Logistics
  leadTimeDays Int? @default(7) @map("lead_time_days")

  // Custom Extension Attributes
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("material_product_details")
}
