// =============================================================================
// HOMIO CRM MARKETPLACE ENUMS
// =============================================================================

enum MarketplaceType {
  DIGITAL_ASSET
  HOME_DECOR
  PROPERTIES
  MATERIALS
  OTHER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyVerificationStatus {
  DRAFT
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum PropertyType {
  APARTMENT
  PENTHOUSE
  BUILDER_FLOOR
  VILLA
  COMMERCIAL
}

enum ListingIntent {
  RENT
  SALE
}

enum DigitalFileFormat {
  PDF
  EPUB
  ZIP
  DWG
  DXF
  RVT
  SKP
  OBJ
  FBX
  DOCX
  XLSX
  OTHER
}

enum AffiliatePartner {
  AMAZON
  PEPPERFRY
  URBAN_LADDER
  WEST_ELM
  IKEA
  CUSTOM
}

enum ProductOwnershipType {
  SELF_OWNED
  VENDOR_OWNED
}

/// Trade Unit of Measurement for Wholesale Materials
enum MaterialUnit {
  // Count
  PIECE
  SET
  PAIR

  // Weight
  GRAM
  KG
  TON

  // Length
  MM
  CM
  METER
  KM

  // Area
  SQ_FT
  SQ_M

  // Volume
  ML
  LITRE

  // Packaging
  SHEET
  BOX
  PACK
  ROLL
  DRUM
  BAG
  BUNDLE
}

// =============================================================================
// MASTER CATEGORY & SELLER TRACKING
// =============================================================================

model MarketplaceCategory {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @map("name")
  code            String          @unique @map("code")
  slug            String          @map("slug")
  marketplaceType MarketplaceType @map("marketplace_type")
  description     String?         @map("description")
  icon            String?         @map("icon")
  imageUrl        Json?           @map("image_url")
  sortOrder       Int             @default(0) @map("sort_order")
  isActive        Boolean         @default(true) @map("is_active")

  // Parent-Child Hierarchy
  parentId String?               @map("parent_id") @db.Uuid
  parent   MarketplaceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children MarketplaceCategory[] @relation("CategoryHierarchy")

  // Product Relations
  digitalProducts   DigitalProduct[]   @relation("CategoryDigitalProducts")
  homeDecorProducts HomeDecorProduct[] @relation("CategoryHomeDecorProducts")
  propertyListings  PropertyListing[]  @relation("CategoryPropertyListings")
  materialProducts  MaterialProduct[]  @relation("CategoryMaterialProducts")

  // Seller Tracking
  sellerAssignments OrganizationMarketplaceCategory[] @relation("CategorySellerAssignments")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([marketplaceType, slug])
  @@index([marketplaceType, isActive])
  @@map("marketplace_categories")
}

model OrganizationMarketplaceCategory {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation("OrganizationMarketplaceCategories", fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String              @map("category_id") @db.Uuid
  category       MarketplaceCategory @relation("CategorySellerAssignments", fields: [categoryId], references: [id], onDelete: Cascade)

  marketplaceType MarketplaceType @map("marketplace_type")
  isApproved      Boolean         @default(false) @map("is_approved")
  isActive        Boolean         @default(true) @map("is_active")
  commissionRate  Decimal?        @map("commission_rate") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, categoryId])
  @@index([organizationId])
  @@index([categoryId])
  @@map("organization_marketplace_categories")
}

// =============================================================================
// VENDOR / SUPPLIER MANAGEMENT
// =============================================================================

model Vendor {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationVendors", fields: [organizationId], references: [id], onDelete: Cascade)

  code                  String?  @map("code")
  name                  String   @map("name")
  companyName           String?  @map("company_name")
  category              String?  @map("category") // e.g. "TILES", "TIMBER", "ELECTRICAL", "FABRICATION", "CONTRACTOR", "SERVICES"
  contactPerson         String?  @map("contact_person")
  email                 String?  @map("email")
  phone                 String?  @map("phone")
  alternatePhone        String?  @map("alternate_phone")
  website               String?  @map("website")
  address               String?  @map("address")
  city                  String?  @map("city")
  state                 String?  @map("state")
  country               String   @default("IN") @map("country")
  pincode               String?  @map("pincode")
  gstin                 String?  @map("gstin")
  panNumber             String?  @map("pan_number")
  bankName              String?  @map("bank_name")
  bankAccountNumber     String?  @map("bank_account_number")
  bankIfscCode          String?  @map("bank_ifsc_code")
  bankBranch            String?  @map("bank_branch")
  paymentTermsDays      Int?     @default(30) @map("payment_terms_days")
  defaultCommissionRate Decimal? @map("default_commission_rate") @db.Decimal(5, 2) // Default % owner gets on product sale
  rating                Float?   @map("rating")
  notes                 String?  @map("notes") @db.Text
  isActive              Boolean  @default(true) @map("is_active")

  // Associated Relations
  homeDecorProducts HomeDecorProduct[] @relation("VendorHomeDecorProducts")
  materialProducts  MaterialProduct[]  @relation("VendorMaterialProducts")
  expenses          Expense[]          @relation("VendorExpenses")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([category])
  @@index([isDeleted, deletedAt])
  @@map("vendors")
}

// =============================================================================
// 1. DIGITAL ASSET & PUBLICATIONS
// =============================================================================

model DigitalProduct {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation("OrganizationDigitalProducts", fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String              @map("category_id") @db.Uuid
  category       MarketplaceCategory @relation("CategoryDigitalProducts", fields: [categoryId], references: [id], onDelete: Restrict)

  name        String   @map("name")
  sku         String   @map("sku")
  urlSlug     String   @map("url_slug")
  description String?  @map("description") @db.Text
  tags        String[] @default([]) @map("tags")
  authorName  String?  @map("author_name")

  // File Details
  fileUrl       String            @map("file_url")
  fileFormat    DigitalFileFormat @default(PDF) @map("file_format")
  fileSize      String?           @map("file_size")
  coverImageUrl Json?             @map("cover_image_url")
  previewImages Json?             @map("preview_images")

  // Access & Limits
  downloadLinkExpiryHours Int @default(48) @map("download_link_expiry_hours")
  maxDownloads            Int @default(5) @map("max_downloads")

  // Pricing
  mrp          Decimal @default(0) @map("mrp") @db.Decimal(12, 2)
  sellingPrice Decimal @default(0) @map("selling_price") @db.Decimal(12, 2)
  taxRate      Decimal @default(18.00) @map("tax_rate") @db.Decimal(5, 2)

  // Status & Metrics
  status         ProductStatus @default(DRAFT) @map("status")
  isFeatured     Boolean       @default(false) @map("is_featured")
  totalPurchases Int           @default(0) @map("total_purchases")
  rating         Decimal       @default(0.0) @map("rating") @db.Decimal(3, 2)
  reviewsCount   Int           @default(0) @map("reviews_count")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, sku])
  @@unique([organizationId, urlSlug])
  @@index([organizationId, status])
  @@index([categoryId])
  @@map("digital_products")
}

// =============================================================================
// 2. HOME DECOR & AFFILIATE PRODUCTS
// =============================================================================

model HomeDecorProduct {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation("OrganizationHomeDecorProducts", fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String              @map("category_id") @db.Uuid
  category       MarketplaceCategory @relation("CategoryHomeDecorProducts", fields: [categoryId], references: [id], onDelete: Restrict)

  // Ownership & Vendor Association
  ownershipType       ProductOwnershipType @default(SELF_OWNED) @map("ownership_type")
  vendorId            String?              @map("vendor_id") @db.Uuid
  vendor              Vendor?              @relation("VendorHomeDecorProducts", fields: [vendorId], references: [id], onDelete: SetNull)
  ownerCommissionRate Decimal?             @map("owner_commission_rate") @db.Decimal(5, 2)

  name        String   @map("name")
  sku         String   @map("sku")
  brandName   String?  @map("brand_name")
  description String?  @map("description") @db.Text
  tags        String[] @default([]) @map("tags")

  // Specifications
  material   String? @map("material")
  color      String? @map("color")
  dimensions String? @map("dimensions")
  roomType   String? @map("room_type")

  // Media
  coverImageUrl Json? @map("cover_image_url")
  galleryUrls   Json? @map("gallery_urls")

  // Pricing & Inventory
  mrp              Decimal @default(0) @map("mrp") @db.Decimal(12, 2)
  sellingPrice     Decimal @default(0) @map("selling_price") @db.Decimal(12, 2)
  taxRate          Decimal @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  inStock          Boolean @default(true) @map("in_stock")
  stockCount       Int     @default(0) @map("stock_count")
  minOrderQuantity Int     @default(1) @map("min_order_quantity")

  // Sample
  sampleAvailable Boolean @default(false) @map("sample_available")
  samplePrice     Decimal @default(0) @map("sample_price") @db.Decimal(12, 2)

  // Affiliate
  isAffiliateEnabled Boolean           @default(false) @map("is_affiliate_enabled")
  affiliatePartner   AffiliatePartner? @map("affiliate_partner")
  affiliateUrl       String?           @map("affiliate_url")
  commissionRate     Decimal           @default(0) @map("commission_rate") @db.Decimal(8, 2)

  // Status
  status       ProductStatus @default(DRAFT) @map("status")
  isFeatured   Boolean       @default(false) @map("is_featured")
  rating       Decimal       @default(0.0) @map("rating") @db.Decimal(3, 2)
  reviewsCount Int           @default(0) @map("reviews_count")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([categoryId])
  @@index([vendorId])
  @@map("home_decor_products")
}

// =============================================================================
// 3. VERIFIED REAL ESTATE PROPERTIES
// =============================================================================

model PropertyListing {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  organization   Organization         @relation("OrganizationPropertyListings", fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?              @map("category_id") @db.Uuid
  category       MarketplaceCategory? @relation("CategoryPropertyListings", fields: [categoryId], references: [id], onDelete: SetNull)

  title        String        @map("title")
  slug         String        @map("slug")
  propertyType PropertyType  @default(APARTMENT) @map("property_type")
  intent       ListingIntent @default(SALE) @map("intent")

  // Verification
  verificationStatus PropertyVerificationStatus @default(DRAFT) @map("verification_status")

  // Specifications
  bhk                 String    @map("bhk")
  bedrooms            Int       @map("bedrooms")
  bathrooms           Int       @map("bathrooms")
  balconies           Int       @default(0) @map("balconies")
  carpetAreaSqft      Int       @map("carpet_area_sqft")
  superBuiltUpSqft    Int?      @map("super_built_up_sqft")
  floorNumber         Int?      @map("floor_number")
  totalFloors         Int?      @map("total_floors")
  furnishingStatus    String    @default("Unfurnished") @map("furnishing_status")
  coveredParkingSlots Int       @default(0) @map("covered_parking_slots")
  availableFrom       DateTime? @map("available_from")

  // Location
  addressLine String?  @map("address_line")
  locality    String   @map("locality")
  city        String   @map("city")
  state       String   @map("state")
  pinCode     String?  @map("pin_code")
  latitude    Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude   Decimal? @map("longitude") @db.Decimal(10, 7)

  // Pricing
  price              Decimal @default(0) @map("price") @db.Decimal(14, 2)
  maintenanceMonthly Decimal @default(0) @map("maintenance_monthly") @db.Decimal(12, 2)
  isNegotiable       Boolean @default(true) @map("is_negotiable")

  // Contact Unlock Monetization (Access time & fee)
  contactUnlockFee          Decimal @default(500) @map("contact_unlock_fee") @db.Decimal(10, 2)
  contactUnlockDurationDays Int     @default(30) @map("contact_unlock_duration_days") // Kitne din tak access kar sakta hai purchase karne ke baad
  totalContactUnlocks       Int     @default(0) @map("total_contact_unlocks")

  // Owner Contact Details (Unlocked after purchase)
  ownerName  String  @map("owner_name")
  ownerPhone String  @map("owner_phone")
  ownerEmail String? @map("owner_email")

  // Amenities & Media
  amenities     String[] @default([]) @map("amenities")
  description   String?  @map("description") @db.Text
  coverImageUrl Json?    @map("cover_image_url")
  images        Json?    @map("images")

  // Status
  status     ProductStatus @default(DRAFT) @map("status")
  isFeatured Boolean       @default(false) @map("is_featured")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([city, locality])
  @@index([propertyType, intent])
  @@map("property_listings")
}

// =============================================================================
// 4. WHOLESALE MATERIALS PROCUREMENT
// =============================================================================

model MaterialProduct {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation("OrganizationMaterialProducts", fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String              @map("category_id") @db.Uuid
  category       MarketplaceCategory @relation("CategoryMaterialProducts", fields: [categoryId], references: [id], onDelete: Restrict)

  // Ownership & Vendor Association
  ownershipType       ProductOwnershipType @default(SELF_OWNED) @map("ownership_type")
  vendorId            String?              @map("vendor_id") @db.Uuid
  vendor              Vendor?              @relation("VendorMaterialProducts", fields: [vendorId], references: [id], onDelete: SetNull)
  ownerCommissionRate Decimal?             @map("owner_commission_rate") @db.Decimal(5, 2)

  name        String   @map("name")
  sku         String   @map("sku")
  brandName   String?  @map("brand_name")
  description String?  @map("description") @db.Text
  tags        String[] @default([]) @map("tags")

  // Material Specifications
  materialType String? @map("material_type")
  grade        String? @map("grade")
  dimensions   String? @map("dimensions")
  thickness    String? @map("thickness")
  application  String? @map("application")

  // Media
  coverImageUrl Json? @map("cover_image_url")
  images        Json? @map("images")

  // Pricing & Measurement
  unitOfMeasure  MaterialUnit @default(PIECE) @map("unit_of_measure")
  wholesalePrice Decimal      @default(0) @map("wholesale_price") @db.Decimal(12, 2)
  retailPrice    Decimal      @default(0) @map("retail_price") @db.Decimal(12, 2)
  taxRate        Decimal      @default(18.00) @map("tax_rate") @db.Decimal(5, 2)

  // Inventory
  minOrderQuantity    Int @default(1) @map("min_order_quantity")
  stockAvailableUnits Int @default(0) @map("stock_available_units")

  // Status
  status      ProductStatus @default(DRAFT) @map("status")
  isFeatured  Boolean       @default(false) @map("is_featured")
  rating      Decimal       @default(0.0) @map("rating") @db.Decimal(3, 2)
  ordersCount Int           @default(0) @map("orders_count")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([categoryId])
  @@index([vendorId])
  @@index([unitOfMeasure])
  @@map("material_products")
}
