// ============================================================================
// HOMIO CRM - SERVICE & LABOUR SCHEMA (NORMALIZED & CLEAN)
// Multi-Tenant B2B SaaS Standards & Dual-Channel Marketplace
// Supports:
// 1. Organization Project Site Allocations (B2B Tenant Interior Design Projects)
// 2. Direct Platform Marketplace Bookings (B2C Urban Company Style Home Services)
// 3. On-Site Deal Quotation, 10% Platform Commission, Task Checklist & App Proof
// 4. Client Payment Default / Dues Escalation (Empanelled Lawyer, Labour Court Action)
// 5. Labour Work Abandonment Disciplinary Action (Warning Counter, Blacklisting)
// 6. Mutual Off-Platform Bypass Attempt Reporting & Governance
// ============================================================================

// ==========================================
// LABOUR LIFECYCLE ENUMS
// ==========================================

enum LabourStatus {
  PENDING       // Initial self-registered or onboarded state awaiting platform admin verification
  AVAILABLE     // Approved by platform admin, verified, and ready for work allocations
  AT_WORK       // Currently deployed / actively on an in-progress service booking or project site
  UNAVAILABLE   // Temporarily off-duty, on leave, or inactive
  REJECTED      // Application rejected during platform verification
  BLACKLISTED   // Permanently blacklisted due to disciplinary or legal violation
}

// ==========================================
// 1. LABOUR PROFILE (WORKER DIRECTORY)
// ==========================================

model Labour {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation("OrganizationLabours", fields: [organizationId], references: [id], onDelete: SetNull)

  // Optional 1-to-1 linkage to SaaS User (for login / RBAC)
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation("UserLabour", fields: [userId], references: [id], onDelete: SetNull)

  // Worker Personal Info
  name     String  @map("name")
  phone    String  @map("phone")
  altPhone String? @map("alt_phone")
  email    String? @map("email")
  photoUrl Json?   @map("photo_url") // ImageType JSON { id, url, bytes, format, provider }

  // Trade & Rate (Plain strings - organization enters freely)
  trade      String   @map("trade") // e.g. "Carpentry", "Masonry", "Plumbing", "Painting"
  skillLevel String?  @default("Skilled") @map("skill_level") // e.g. "Helper", "Skilled", "Master / Mistry"
  dailyRate  Decimal  @map("daily_rate") @db.Decimal(10, 2) // Standard 8-hour day rate (e.g. ₹950.00)
  hourlyRate Decimal? @map("hourly_rate") @db.Decimal(10, 2) // Optional overtime hourly rate

  // Address & Identity (State, City & Locality Filtering)
  address  String? @map("address")
  state    String? @map("state")
  city     String? @map("city")
  locality String? @map("locality") // Explicit locality for micro-filtering
  pincode  String? @map("pincode")

  // Real-Time Availability & KYC Verification
  isAvailable   Boolean @default(false) @map("is_available")
  isKycVerified Boolean @default(false) @map("is_kyc_verified")

  // Aggregated Ratings & Performance Metrics
  averageRating          Float @default(5.0) @map("average_rating")
  totalReviewsCount      Int   @default(0)   @map("total_reviews_count")
  completedBookingsCount Int   @default(0)   @map("completed_bookings_count")

  // Disciplinary Counters & Blacklisting (Flowchart: Company Action - Warning, Blacklisting)
  warningCount    Int       @default(0)     @map("warning_count")
  isBlacklisted   Boolean   @default(false) @map("is_blacklisted")
  blacklistedAt   DateTime? @map("blacklisted_at")
  blacklistReason String?   @map("blacklist_reason")

  aadhaarNo  String? @map("aadhaar_no")
  aadhaarDoc Json?   @map("aadhaar_doc") // ImageType JSON

  // Bank & Settlement Details
  bankName      String? @map("bank_name")
  bankAccountNo String? @map("bank_account_no")
  ifscCode      String? @map("ifsc_code")
  upiId         String? @map("upi_id")

  // Emergency Contact
  emergencyContact String? @map("emergency_contact")
  emergencyPhone   String? @map("emergency_phone")

  // Status & Governance
  status    LabourStatus @default(PENDING) @map("status") // PENDING, AVAILABLE, AT_WORK, UNAVAILABLE, REJECTED, BLACKLISTED
  isDeleted Boolean   @default(false)    @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Universal Additional Information (Rule 18)
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Normalized Relations
  kycDocument  LabourKycDocument?
  bookings     LabourBooking[]    @relation("LabourBookings")
  attendances  LabourAttendance[] @relation("LabourAttendances")
  payments     LabourPayment[]    @relation("LabourPayments")
  ratings      LabourRating[]     @relation("LabourRatings")
  disputes     LabourDispute[]    @relation("LabourDisputes")
  projectBills ProjectBill[]      @relation("LabourProjectBills")

  @@index([organizationId])
  @@index([phone])
  @@index([trade])
  @@index([status])
  @@index([state])
  @@index([city])
  @@index([isAvailable])
  @@index([isKycVerified])
  @@map("labours")
}

// ==========================================
// 2. LABOUR KYC DOCUMENTS & VERIFICATION
// ==========================================

model LabourKycDocument {
  id       String @id @default(uuid()) @db.Uuid
  labourId String @unique @map("labour_id") @db.Uuid
  labour   Labour @relation(fields: [labourId], references: [id], onDelete: Cascade)

  // Document Attachments (ImageType JSON)
  aadhaarNumber      String? @map("aadhaar_number")
  aadhaarDoc         Json?   @map("aadhaar_doc")
  selfiePhoto        Json?   @map("selfie_photo")
  policeClearanceDoc Json?   @map("police_clearance_doc")
  policeStationName  String? @map("police_station_name")

  // Bank Account Snapshot
  bankAccountNo     String? @map("bank_account_no")
  ifscCode          String? @map("ifsc_code")
  bankName          String? @map("bank_name")
  accountHolderName String? @map("account_holder_name")
  upiId             String? @map("upi_id")

  // Verification Details
  tradeTestScore    Float?    @map("trade_test_score")
  status            String    @default("PENDING") @map("status") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  verificationNotes String?   @map("verification_notes") @db.Text
  rejectionReason   String?   @map("rejection_reason")
  verifiedAt        DateTime? @map("verified_at")
  verifiedBy        String?   @map("verified_by") // Admin / Supervisor name

  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([status])
  @@map("labour_kyc_documents")
}

// ============================================================================
// 3. PROJECT SERVICE (SCOPE OF WORK & DELIVERABLE UNDER A PROJECT)
// ============================================================================

model ProjectService {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationProjectServices", fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectServices", fields: [projectId], references: [id], onDelete: Cascade)

  serviceCode String  @map("service_code") // e.g. "SRV-2026-0001"
  title       String  @map("title")        // e.g. "False Ceiling & Gypsum Work"
  description String? @map("description")  @db.Text
  scopeOfWork String? @map("scope_of_work") @db.Text
  location    String? @map("location")
  category    String  @map("category")     // e.g. "Carpentry", "Civil", "Painting"
  priority    String  @default("MEDIUM")   @map("priority") // LOW, MEDIUM, HIGH, URGENT

  // Schedule Milestones
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date")   @db.Date
  actualStartDate    DateTime? @map("actual_start_date") @db.Date
  actualEndDate      DateTime? @map("actual_end_date")   @db.Date
  completionDeadline    DateTime? @map("completion_deadline") @db.Date
  estimatedDurationDays Int?      @default(1) @map("estimated_duration_days")

  // Execution Status
  status         String  @default("PLANNED") @map("status") // PLANNED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  progressPct    Int     @default(0)         @map("progress_pct") // 0 to 100%
  completionSign Json?   @map("completion_sign") // ImageType JSON
  signOffNotes   String? @map("sign_off_notes")  @db.Text

  // Commercials & Financial Rollup
  estimatedBudget Decimal @default(0.00) @map("estimated_budget") @db.Decimal(12, 2)
  actualCost      Decimal @default(0.00) @map("actual_cost")      @db.Decimal(12, 2)
  totalPaid       Decimal @default(0.00) @map("total_paid")        @db.Decimal(12, 2)

  // Supervisor Allocation
  supervisorId String?   @map("supervisor_id") @db.Uuid
  supervisor   Employee? @relation("ProjectServiceSupervisors", fields: [supervisorId], references: [id], onDelete: SetNull)

  // Soft Delete & Extensibility (Universal Rule 18)
  isDeleted             Boolean   @default(false) @map("is_deleted")
  deletedAt             DateTime? @map("deleted_at")
  additionalInformation Json?     @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations (Multiple Labour Bookings Allocated for this Service)
  labourBookings LabourBooking[] @relation("ProjectServiceLabourBookings")

  @@unique([organizationId, serviceCode])
  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([supervisorId])
  @@map("project_services")
}

// ============================================================================
// 4. LABOUR BOOKING (DUAL CHANNEL: B2B PROJECT SITE & B2C PLATFORM MARKETPLACE)
// ============================================================================

model LabourBooking {
  id String @id @default(uuid()) @db.Uuid

  // 1. Channel Discriminator (ORGANIZATION_PROJECT or PLATFORM_MARKETPLACE)
  channel String @default("ORGANIZATION_PROJECT") @map("channel")

  // 2. Organization & Project Scope (Optional for B2B)
  organizationId   String?         @map("organization_id") @db.Uuid
  organization     Organization?   @relation("OrganizationLabourBookings", fields: [organizationId], references: [id], onDelete: SetNull)
  projectId        String?         @map("project_id") @db.Uuid
  project          Project?        @relation("ProjectLabourBookings", fields: [projectId], references: [id], onDelete: Cascade)
  projectServiceId String?         @map("project_service_id") @db.Uuid
  projectService   ProjectService? @relation("ProjectServiceLabourBookings", fields: [projectServiceId], references: [id], onDelete: Cascade)

  // 3. Client / Homeowner Scope (Optional for B2C Marketplace)
  clientId String? @map("client_id") @db.Uuid
  client   User?   @relation("ClientMarketplaceBookings", fields: [clientId], references: [id], onDelete: SetNull)

  // 4. Assigned Worker (Optional: null when awaiting manual assignment)
  labourId String? @map("labour_id") @db.Uuid
  labour   Labour? @relation("LabourBookings", fields: [labourId], references: [id], onDelete: Restrict)

  bookingNumber       String   @map("booking_number") // e.g. "LB-2026-0001"
  workTitle           String   @map("work_title")
  category            String?  @default("General") @map("category") // e.g. "Carpentry", "Plumbing", "Electrical", "Painting", "Civil"
  workDescription     String?  @map("work_description") @db.Text
  specialInstructions String?  @map("special_instructions") @db.Text
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime @map("end_date")   @db.Date

  // 5. Service Location (Client Home Address & Explicit Locality)
  serviceAddress   String?  @map("service_address")
  locality         String?  @map("locality") // Explicit locality box
  city             String?  @map("city")
  state            String?  @map("state")
  pincode          String?  @map("pincode")
  latitude         Decimal? @map("latitude")  @db.Decimal(10, 7)
  longitude        Decimal? @map("longitude") @db.Decimal(10, 7)
  geofenceRadius   Int      @default(200) @map("geofence_radius")
  isStrictGeofence Boolean  @default(true) @map("is_strict_geofence")

  // 6. Assignment Metadata & Terms
  assignmentType  String    @default("AUTO") @map("assignment_type") // AUTO | MANUAL
  termsAccepted   Boolean   @default(false)  @map("terms_accepted")
  termsAcceptedAt DateTime? @map("terms_accepted_at")

  // 7. Agreed Financials & On-Site Deal Quotation
  agreedDailyRate Decimal?  @default(0.00) @map("agreed_daily_rate") @db.Decimal(10, 2)
  estimatedDays   Int       @default(1)    @map("estimated_days")
  totalBudget     Decimal   @default(0.00) @map("total_budget")      @db.Decimal(12, 2)
  totalPaid       Decimal   @default(0.00) @map("total_paid")        @db.Decimal(12, 2)

  // On-Site Inspection Quote (Labour submits price quote on arrival)
  quoteAmount      Decimal?  @map("quote_amount")       @db.Decimal(12, 2)
  quoteDescription String?   @map("quote_description") @db.Text
  quoteSubmittedAt DateTime? @map("quote_submitted_at")
  dealValue        Decimal?  @map("deal_value")        @db.Decimal(12, 2)
  dealAcceptedAt   DateTime? @map("deal_accepted_at")

  // Platform Commission (10% if Marketplace; 0% if Org Project)
  commissionRate   Decimal   @default(0.00) @map("commission_rate")   @db.Decimal(5, 2)
  commissionAmount Decimal   @default(0.00) @map("commission_amount") @db.Decimal(12, 2)
  commissionStatus String    @default("NOT_APPLICABLE") @map("commission_status") // NOT_APPLICABLE, PENDING, PAID, OVERDUE, WAIVED
  commissionPaidAt DateTime? @map("commission_paid_at")

  // 8. Lifecycle Status (State Machine)
  // REQUESTED, CONFIRMED, REJECTED_BY_LABOUR, ACCEPTED_BY_LABOUR, QUOTE_PROVIDED,
  // QUOTE_REJECTED, WORK_STARTED, IN_PROGRESS, WORK_COMPLETED, COMPLETED, CANCELLED, DISPUTED
  status       String    @default("CONFIRMED") @map("status")
  statusReason String?   @map("status_reason")
  acceptedAt   DateTime? @map("accepted_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  delayReportedAt DateTime? @map("delay_reported_at")
  notes           String?   @map("notes") @db.Text

  // 9. Checklist & Verification Proof (Flowchart: Task Checklist & Proof on App)
  taskChecklist           Json?   @map("task_checklist")
  proofPhotos             Json?   @map("proof_photos")
  reassignedFromBookingId String? @map("reassigned_from_booking_id") @db.Uuid

  // Soft Delete & Extensibility
  isDeleted             Boolean   @default(false) @map("is_deleted")
  deletedAt             DateTime? @map("deleted_at")
  additionalInformation Json?     @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations
  attendances LabourAttendance[] @relation("BookingAttendances")
  payments    LabourPayment[]    @relation("BookingPayments")
  ratings     LabourRating[]     @relation("BookingRatings")
  disputes    LabourDispute[]    @relation("BookingDisputes")

  @@index([bookingNumber])
  @@index([channel])
  @@index([organizationId])
  @@index([projectId])
  @@index([projectServiceId])
  @@index([clientId])
  @@index([labourId])
  @@index([status])
  @@index([state, city])
  @@index([category])
  @@map("labour_bookings")
}

// ============================================================================
// 5. LABOUR ATTENDANCE (GEOFENCED PUNCH-IN & PUNCH-OUT)
// ============================================================================

model LabourAttendance {
  id            String       @id @default(uuid()) @db.Uuid
  projectSiteId String?      @map("project_site_id") @db.Uuid
  projectSite   ProjectSite? @relation("ProjectSiteLabourAttendances", fields: [projectSiteId], references: [id], onDelete: Cascade)

  labourId String @map("labour_id") @db.Uuid
  labour   Labour @relation("LabourAttendances", fields: [labourId], references: [id], onDelete: Cascade)

  bookingId String?        @map("booking_id") @db.Uuid
  booking   LabourBooking? @relation("BookingAttendances", fields: [bookingId], references: [id], onDelete: SetNull)

  attendanceDate DateTime @map("attendance_date") @db.Date
  status         String   @default("PENDING_APPROVAL") @map("status") // PRESENT, HALF_DAY, OVERTIME, ABSENT, PENDING_APPROVAL, GEO_MISMATCH

  // Punch In Data
  punchInTime            DateTime? @map("punch_in_time")
  punchInLatitude        Decimal?  @map("punch_in_latitude") @db.Decimal(10, 7)
  punchInLongitude       Decimal?  @map("punch_in_longitude") @db.Decimal(10, 7)
  punchInDistanceMeters  Float?    @map("punch_in_distance_meters")
  punchInAddress         String?   @map("punch_in_address")
  punchInPhoto           Json?     @map("punch_in_photo") // ImageType JSON

  // Punch Out Data
  punchOutTime           DateTime? @map("punch_out_time")
  punchOutLatitude       Decimal?  @map("punch_out_latitude") @db.Decimal(10, 7)
  punchOutLongitude      Decimal?  @map("punch_out_longitude") @db.Decimal(10, 7)
  punchOutDistanceMeters Float?    @map("punch_out_distance_meters")
  punchOutAddress        String?   @map("punch_out_address")
  punchOutPhoto          Json?     @map("punch_out_photo")

  // Work Hours, Wage & Notes
  workNotes   String?  @map("work_notes") @db.Text
  hoursWorked Decimal? @map("hours_worked") @db.Decimal(4, 2)
  rateApplied Decimal? @map("rate_applied") @db.Decimal(10, 2)
  wageEarned  Decimal? @map("wage_earned")  @db.Decimal(10, 2)

  // Supervisor Approval
  supervisorApproved   Boolean   @default(false) @map("supervisor_approved")
  supervisorApprovedAt DateTime? @map("supervisor_approved_at")
  supervisorApprovedBy String?   @map("supervisor_approved_by")
  rejectionReason      String?   @map("rejection_reason")

  // Universal Additional Information (Rule 18)
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([projectSiteId])
  @@index([labourId])
  @@index([bookingId])
  @@index([attendanceDate])
  @@index([status])
  @@map("labour_attendances")
}

// ==========================================
// 6. LABOUR PAYMENT (WAGE PAYMENTS & SETTLEMENT)
// ==========================================

model LabourPayment {
  id       String @id @default(uuid()) @db.Uuid
  labourId String @map("labour_id") @db.Uuid
  labour   Labour @relation("LabourPayments", fields: [labourId], references: [id], onDelete: Restrict)

  bookingId String?        @map("booking_id") @db.Uuid
  booking   LabourBooking? @relation("BookingPayments", fields: [bookingId], references: [id], onDelete: SetNull)

  // Payment Details
  amount         Decimal  @map("amount") @db.Decimal(10, 2)
  daysCount      Int      @default(1) @map("days_count")
  paymentDate    DateTime @default(now()) @map("payment_date")
  paymentMethod  String   @default("CASH") @map("payment_method") // CASH, UPI, BANK_TRANSFER
  transactionRef String?  @map("transaction_ref") // UPI ID / UTR No / Cash Voucher No
  receiptPhoto   Json?    @map("receipt_photo") // ImageType JSON
  status         String   @default("PAID") @map("status") // PAID, PENDING, CANCELLED
  remarks        String?  @map("remarks")

  // Universal Additional Information (Rule 18)
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([labourId])
  @@index([bookingId])
  @@index([paymentDate])
  @@map("labour_payments")
}

// ==========================================
// 7. LABOUR RATING (SERVICE BOOKING REVIEW)
// ==========================================

model LabourRating {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @map("booking_id") @db.Uuid
  booking   LabourBooking @relation("BookingRatings", fields: [bookingId], references: [id], onDelete: Cascade)

  labourId String @map("labour_id") @db.Uuid
  labour   Labour @relation("LabourRatings", fields: [labourId], references: [id], onDelete: Cascade)

  reviewerId       String? @map("reviewer_id") @db.Uuid
  reviewerName     String  @map("reviewer_name")
  reviewerRole     String  @default("CLIENT") @map("reviewer_role") // SUPERVISOR, CLIENT, LABOUR, MANAGER
  rating           Float   @map("rating") // 1.0 to 5.0
  qualityScore     Float?  @map("quality_score")
  punctualityScore Float?  @map("punctuality_score")
  behaviourScore   Float?  @map("behaviour_score")
  reviewNotes      String? @map("review_notes") @db.Text

  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([bookingId])
  @@index([labourId])
  @@map("labour_ratings")
}

// ==========================================
// 8. LABOUR DISPUTE (LEGAL, SITE & MARKETPLACE DISPUTES)
// ==========================================

model LabourDispute {
  id       String @id @default(uuid()) @db.Uuid
  labourId String @map("labour_id") @db.Uuid
  labour   Labour @relation("LabourDisputes", fields: [labourId], references: [id], onDelete: Cascade)

  bookingId String?        @map("booking_id") @db.Uuid
  booking   LabourBooking? @relation("BookingDisputes", fields: [bookingId], references: [id], onDelete: SetNull)

  // Categorization
  // NON_PAYMENT_BY_CLIENT, WORK_ABANDONMENT_BY_LABOUR, BYPASS_ATTEMPT, QUALITY_BREACH, SAFETY_VIOLATION, OTHER
  disputeType       String  @default("OTHER") @map("dispute_type")
  amountInDispute   Decimal @default(0.00)    @map("amount_in_dispute") @db.Decimal(12, 2)
  status            String  @default("OPEN")     @map("status") // OPEN, UNDER_INVESTIGATION, LAWYER_ASSIGNED, NOTICE_ISSUED, LABOUR_COURT_FILED, SETTLED, CLOSED
  initiator         String  @default("CLIENT")   @map("initiator") // CLIENT, LABOUR, CONTRACTOR, PLATFORM_SYSTEM
  reason            String  @map("reason") @db.Text
  resolutionSummary String? @map("resolution_summary") @db.Text

  // Empanelled Lawyer Assignment (Flowchart: Common Lawyer Assigning to Labour)
  lawyerAssigned     Boolean   @default(false) @map("lawyer_assigned")
  lawyerName         String?   @map("lawyer_name")
  lawyerPhone        String?   @map("lawyer_phone")
  lawyerBarCouncilNo String?   @map("lawyer_bar_council_no")
  lawyerAssignedAt   DateTime? @map("lawyer_assigned_at")

  // Legal Proceedings & Labour Court Action (Flowchart: Labour Court Action on Client)
  legalNoticeSent   Boolean   @default(false) @map("legal_notice_sent")
  legalNoticeDate   DateTime? @map("legal_notice_date")
  legalNoticeDoc    Json?     @map("legal_notice_doc") // ImageType JSON
  labourCourtFiled  Boolean   @default(false) @map("labour_court_filed")
  labourCourtCaseNo String?   @map("labour_court_case_no")
  labourCourtDate   DateTime? @map("labour_court_date")

  hearingDate  DateTime? @map("hearing_date")
  evidenceDocs Json?     @map("evidence_docs") // Array of ImageType JSON (geotagged site photos, chat proof)
  actionTaken  String?   @map("action_taken") // CLIENT_RATING_DOWN, CLIENT_BLACKLISTED, LABOUR_WARNED, LABOUR_BLACKLISTED,LABOUR_RATING_DOWN, LEGAL_ACTION

  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([labourId])
  @@index([bookingId])
  @@index([status])
  @@index([disputeType])
  @@map("labour_disputes")
}

// ==========================================
// 9. PLATFORM LABOUR CONFIGURATION & SETTINGS
// ==========================================

model PlatformLabourSetting {
  id                             String   @id @default(uuid()) @db.Uuid
  autoAssignLabour               Boolean  @default(true) @map("auto_assign_labour")
  platformCommissionRate         Decimal  @default(10.00) @map("platform_commission_rate") @db.Decimal(5, 2)
  cooldownPeriodDays             Int      @default(3) @map("cooldown_period_days")
  consecutiveRejectionsThreshold Int      @default(3) @map("consecutive_rejections_threshold")
  delayReportMinHours            Int      @default(24) @map("delay_report_min_hours")

  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("PlatformLabourSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("platform_labour_settings")
}

// ==========================================
// 10. USER LABOUR CATEGORY COOLDOWN & ANTI-ABUSE
// ==========================================

model UserLabourCategoryCooldown {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation("UserLabourCategoryCooldowns", fields: [userId], references: [id], onDelete: Cascade)
  category       String    @map("category") // Normalized trade name e.g. "Carpentry", "Plumbing"
  rejectionCount Int       @default(0) @map("rejection_count")
  isLocked       Boolean   @default(false) @map("is_locked")
  lockedUntil    DateTime? @map("locked_until")
  lastRejectedAt DateTime? @map("last_rejected_at")

  // Audit history log: [{ bookingId, labourId, rejectedAt, reason }]
  rejectionLogs Json? @map("rejection_logs")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([userId, category])
  @@index([userId, category, isLocked])
  @@map("user_labour_category_cooldowns")
}

