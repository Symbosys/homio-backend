// ==========================================
// PROJECT ENUMS
// ==========================================

enum ProjectType {
  TURNKEY // End-to-end design & build execution
  CONSULTING // Advisory / design-only consulting
  FORM_BASED // Simple / templated form-based project
  INTERIOR_DESIGN // Custom interior designing & 3D styling
  RENOVATION // Remodeling & civil restoration
  COMMERCIAL // Commercial workspace / retail fit-out
  RESIDENTIAL // Residential home / villa
}

enum ProjectStatus {
  DRAFT // Initial onboarding & scope definition
  PLANNED // Kickoff planned, awaiting resource allocation
  DESIGN // 2D/3D design & moodboard phase
  APPROVAL_PENDING // Client / management signoff pending
  EXECUTION // Active on-site procurement & construction
  ON_HOLD // Temporarily paused by client/contractor
  DELAYED // Critical path blocked / timeline breached
  COMPLETED // Work finished, pending final handover
  HANDOVER // Formal site & key handover to client
  CLOSED // Final settlement completed & archived
  CANCELLED // Project terminated
}

enum ProjectDesignStatus {
  NOT_STARTED
  IN_PROGRESS
  APPROVAL_PENDING
  REVISION_REQUESTED
  APPROVED
  COMPLETED
  ON_HOLD
}

enum ProjectExecutionStatus {
  NOT_STARTED
  SITE_SURVEY
  CIVIL_WORK
  CARPENTRY
  ELECTRICAL_MEP
  FINISHING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  HANDOVER
}

enum ProjectHealth {
  HEALTHY // On schedule, within budget
  NEED_ATTENTION // Minor timeline or material risk detected
  AT_RISK // Critical timeline or blocker risk detected
}

enum ProjectStage {
  ONBOARDING // Initial client onboarding & requirements kickoff
  SURVEY // Site survey, laser dimensions & measurements (replaced PLANNING)
  DESIGN // Architectural, structural & interior design
  APPROVAL // Client drawing & estimate signoff
  PROCUREMENT // Material sourcing & vendor purchase orders
  EXECUTION // Site civil, electrical, carpentry & painting
  HANDOVER // Snag list resolution & key handover
  AFTER_SALES // Warranty & maintenance support
}

enum StageStatus {
  NOT_STARTED // Unassigned / Not started (no color)
  ASSIGNED // Assigned to personnel (blue)
  IN_PROGRESS // Actively in progress (yellow)
  COMPLETED // Done / Finished (green)
  ON_HOLD // Blocked / On hold (red)
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  LEAD_DESIGNER
  ASSISTANT_DESIGNER
  SITE_SUPERVISOR
  SITE_ENGINEER
  SALES_OWNER
  PROCUREMENT_MANAGER
  QUALITY_AUDITOR
  MEP_CONSULTANT
  SAFETY_OFFICER
  OTHER
}

enum MilestoneType {
  DESIGN
  EXECUTION
}

enum MilestoneStatus {
  NOT_STARTED // Milestone scheduled but not active
  IN_PROGRESS // Execution actively ongoing
  PENDING_APPROVAL // Work submitted for client/QA approval
  COMPLETED // Milestone verified and signed off
  DELAYED // Critical deadline breached
  BLOCKED // Impeded by external dependency / dispute
  CANCELLED // Dropped from scope
}

enum ProgressVisibility {
  INTERNAL // Visible only to internal organization team
  CLIENT_VISIBLE // Displayed on Client Portal & customer reports
}

enum ProgressApprovalStatus {
  DRAFT // Work log being drafted by site engineer
  SUBMITTED // Submitted for Project Manager review
  APPROVED // Approved by PM / Lead Architect
  REJECTED // Rejected due to defects/snags
  REVISION_REQUESTED // Minor fixes requested
}

enum ApprovalType {
  DESIGN // 2D/3D Floor plans, elevations, moodboards, 3D renders
  MATERIAL // Tile, laminate, veneer, fabric, hardware, sanitaryware
  EXECUTION_STAGE // Civil work, false ceiling, MEP rough-in
  WORK_COMPLETION // Milestone or phase completion verification
  PAYMENT // Milestone or variation payment signoff
  FINAL_HANDOVER // Final site handover & possession
  OTHER // Custom signoff
}

enum ApprovalStatus {
  PENDING // Awaiting client review
  APPROVED // Approved by client
  REJECTED // Rejected by client
  REVISION_REQUESTED // Client requested changes / alterations
  RESUBMITTED // Resubmitted after implementing revisions
}

enum ComplaintType {
  DESIGN // Design discrepancy or aesthetic flaw
  QUALITY // Workmanship or finish defect
  MATERIAL // Substandard or damaged material
  EXECUTION // Structural, plumbing, or electrical issue
  TIMELINE // Timeline or delay issue
  BEHAVIOUR // On-site personnel or contractor conduct
  PAYMENT // Commercial or invoice dispute
  COMMUNICATION // Lack of communication or updates
  WARRANTY // Post-handover defect
  OTHER // Miscellaneous grievance
}

enum ComplaintStatus {
  OPEN // Ticket raised
  ACKNOWLEDGED // Acknowledged by team
  ASSIGNED // Assigned to site engineer / vendor
  IN_PROGRESS // Rectification underway
  WAITING // Awaiting client confirmation or replacement materials
  RESOLVED // Rectified and internally verified
  CLOSED // Client verified and closed
  REJECTED // Invalid / out of warranty / out of scope
  REOPENED // Reopened if unresolved
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeRequestStatus {
  PENDING // Submitted by client, awaiting organization review
  IN_REVIEW // Under evaluation by design / project team
  ACCEPTED // Accepted by team, actively incorporating revisions
  REJECTED // Rejected / infeasible / out of scope
  IMPLEMENTED // Completed & resubmitted for client sign-off
}

// ==========================================
// SITE VISIT ENUMS
// ==========================================

enum SiteVisitType {
  MEASUREMENT // Initial site survey, laser dimensions, as-built mapping
  DESIGN // Design & moodboard validation at site
  EXECUTION // Active construction / installation oversight
  INSPECTION // Quality & safety audit inspection
  SUPERVISOR // Routine supervisor daily site round
  CLIENT // Client walkthrough & physical site review
  MATERIAL_INSPECTION // Inflow material delivery check & verification
  FINAL_INSPECTION // Snaglist & pre-handover final inspection
  OTHER // Custom visit
}

enum SiteVisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum SiteVisitOutcome {
  COMPLETED // Successfully completed with all points addressed
  ISSUES_FOUND // Defects, snags, or non-compliance detected
  FOLLOW_UP_REQUIRED // Additional visit or engineering action required
  PENDING_APPROVAL // Sign-off / drawing revision pending
}

// ==========================================
// EXPENSE ENUMS
// ==========================================

enum ExpenseScope {
  PROJECT // Cost directly attributed to a specific project
  ORGANIZATION // General company / overhead operational expense
  BOTH // Applicable to both project & organization expenses
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  PETTY_CASH
  OTHER
}

enum ExpensePaymentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  PARTIALLY_PAID
  REJECTED
  CANCELLED
}

// ==========================================
// PROJECT HANDOVER ENUMS
// ==========================================

enum ProjectHandoverStatus {
  DRAFT // Organization site team drafting handover package
  SCHEDULED // Formal handover inspection & possession date scheduled
  INSPECTION_PENDING // Joint site inspection walkthrough pending
  SNAGS_IN_PROGRESS // Punch-list rectification actively ongoing prior to possession
  CLIENT_REVIEW // Deliverables, warranties & documents under client review
  ACCEPTED // Client signed acceptance & possession certificate
  REJECTED // Handover rejected by client due to critical defects/disputes
  COMPLETED // Keys delivered, warranty active, project archived
  CANCELLED // Handover cancelled / aborted
}

enum HandoverItemCategory {
  KEYS // Main door, bedrooms, wardrobes, utility, DB box, terrace
  ACCESS_CARD_OR_REMOTE // Smart lock RFID cards, gate remotes, sensor fobs, automation pads
  APPLIANCE_MANUAL // Hob, chimney, microwave, dishwasher, geyser manuals
  WARRANTY_DOCUMENT // Manufacturer & contractor warranty cards (woodwork, waterproofing, paint)
  AS_BUILT_DRAWING // Final as-built MEP, electrical conduit & plumbing line drawings
  MAINTENANCE_GUIDE // Marble polish, veneer care, fabric care instructions
  SPARE_MATERIAL // Extra tiles, touch-up paint cans, extra laminate, hardware
  OTHER // Custom hand-off deliverable
}

enum HandoverItemStatus {
  PENDING // Prepared but not yet inspected/handed over
  VERIFIED // Verified ready by internal site supervisor
  HANDED_OVER // Physically received and acknowledged by client
  NOT_APPLICABLE // Waived or not applicable for this project
}

enum HandoverSnagSeverity {
  LOW // Cosmetic flaw (minor scuff mark, paint smudge, uneven silicone bead)
  MEDIUM // Functional defect (stiff latch, loose hinge, misaligned switch plate)
  HIGH // Significant defect (cracked tile, plumbing drip, deep veneer scratch)
  CRITICAL // Safety or handover blocker (short circuit, active water seepage)
}

enum HandoverSnagStatus {
  REPORTED // Snag identified during joint walkthrough
  IN_PROGRESS // Work assigned to vendor / trade contractor
  RESOLVED // Work rectified and checked by site engineer
  ACCEPTED_BY_CLIENT // Client verified and cleared the snag
  WAIVED // Mutually agreed to waive or deferred to DLP
}

// ==========================================
// PROJECT PAYMENT & COMMERCIAL ENUMS
// ==========================================

enum ProjectPaymentType {
  DESIGN_FEE              // Architectural & 3D Interior Design fee
  MATERIAL_PAYMENT        // Raw & finishing material procurement
  LABOUR_PAYMENT          // Site carpentry, civil & MEP workforce
  SUPERVISION_FEE         // Site engineer / PMC supervision fee
  TURNKEY_PACKAGE         // End-to-end turnkey milestone installment
  CONSULTING_PERCENTAGE   // % of estimated/actual project cost
  CONSULTING_LUMP_SUM     // Fixed lump sum consulting fee
  CONSULTING_SQFT         // Rate per square foot fee
  MOBILIZATION_ADVANCE    // Initial project kickoff / booking advance
  RETENTION_RELEASE       // Handover & snag resolution retention release
  VARIATION_ORDER         // Client change request / additional scope
  OTHER                   // Miscellaneous / Custom commercial head
}

enum PaymentFlowDirection {
  INFLOW    // Received from Client / Customer
  OUTFLOW   // Paid out for Project (Vendor, Contractor, Labour, Consultant)
}

enum ProjectPaymentStatus {
  PENDING       // Initiated / Awaiting bank confirmation
  COMPLETED     // Successfully received / paid & reconciled
  FAILED        // Transaction bounced / failed
  CANCELLED     // Voided by administrator
  REFUNDED      // Partially or fully refunded
}

enum ProjectPricingModel {
  TURNKEY_WITH_MATERIALS   // Material + Labour + Design in milestone tranches
  CONSULTING_PERCENTAGE    // % fee on estimated / actual site expense
  CONSULTING_LUMP_SUM      // Fixed project management / consulting lumpsum
  DESIGN_CONSULTING_SQFT   // Per sqft architectural & styling fee
}

enum ProjectPaymentMethod {
  BANK_TRANSFER // NEFT / RTGS / IMPS
  UPI           // Google Pay / PhonePe / Paytm / BHIM
  CHEQUE        // Bank Cheque / Demand Draft
  CASH          // Cash transaction (with receipt)
  CREDIT_CARD   // Corporate or Client Credit Card
  DEBIT_CARD    // Debit Card
  PAYMENT_GATEWAY // Razorpay / Stripe / PayU
  OTHER
}

// ==========================================
// 1. CORE PROJECT MODEL (Tenant Root)
// ==========================================

model Project {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationProjects", fields: [organizationId], references: [id], onDelete: Cascade)

  // Client & Lead Attribution
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation("CustomerProjects", fields: [customerId], references: [id], onDelete: Restrict)

  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation("LeadProjects", fields: [leadId], references: [id], onDelete: SetNull)

  // Identity & Classification
  projectCode  String          @map("project_code") // e.g. "PRJ-2026-0001"
  name         String          @map("name")
  description  String?         @map("description") @db.Text
  category        String?                @map("category") // e.g. "Residential Luxury", "Modular Kitchen"
  type            ProjectType            @default(TURNKEY) @map("type")
  status          ProjectStatus          @default(PLANNED) @map("status")
  designStatus    ProjectDesignStatus    @default(NOT_STARTED) @map("design_status")
  executionStatus ProjectExecutionStatus @default(NOT_STARTED) @map("execution_status")
  health          ProjectHealth          @default(HEALTHY) @map("health")
  currentStage    ProjectStage           @default(ONBOARDING) @map("current_stage")
  activeStages    ProjectStage[]         @default([ONBOARDING]) @map("active_stages")
  stageStatuses   Json?                  @map("stage_statuses") // Map of { [ProjectStage]: { status: StageStatus, progressPercent?: number, ... } }
  priority        ProjectPriority        @default(MEDIUM) @map("priority")

  // Cloud Media (ImageType JSON: { id, url, bytes, format, provider })
  coverImageUrl Json? @map("cover_image_url")

  // Creator audit
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Client Portal Settings & Client Feedback
  isClientPortalVisible Boolean @default(true) @map("is_client_portal_visible")
  clientRating          Float?  @map("client_rating")
  clientFeedback        String? @map("client_feedback") @db.Text

  // Metadata, Tags & Custom Fields
  tags                  String[] @default([]) @map("tags")
  notes                 String?  @map("notes") @db.Text
  customFields          Json?    @map("custom_fields")
  additionalInformation Json?    @map("additional_information")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Service Category Master Scope
  serviceCategoryId String?          @map("service_category_id") @db.Uuid
  serviceCategory   ServiceCategory? @relation("ProjectServiceCategory", fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  // 1-to-1 & 1-to-Many Segregated Relations
  site                      ProjectSite?
  schedule                  ProjectSchedule?
  metric                    ProjectMetric?
  commercial                ProjectCommercial?
  members                   ProjectMember[]
  milestones                ProjectMilestone[]         @relation("ProjectMilestones")
  progressEntries           ProjectProgress[]          @relation("ProjectProgressEntries")
  workApprovals             WorkApproval[]             @relation("ProjectWorkApprovals")
  complaints                ProjectComplaint[]         @relation("ProjectComplaints")
  siteVisits                ProjectSiteVisit[]         @relation("ProjectSiteVisits")
  expenses                  Expense[]                  @relation("ProjectExpenses")
  designFolders             ProjectDesignFolder[]      @relation("ProjectDesignFolders")
  designs                   ProjectDesign[]            @relation("ProjectDesigns")
  designApprovals           DesignVersionApproval[]    @relation("ProjectDesignApprovals")
  materialRequests          MaterialRequest[]          @relation("ProjectMaterialRequests")
  vendorRfqs                VendorRfq[]                @relation("ProjectVendorRfqs")
  vendorQuotations          VendorQuotation[]          @relation("ProjectVendorQuotations")
  materialDispatches        MaterialDispatch[]         @relation("ProjectMaterialDispatches")
  handovers                 ProjectHandover[]          @relation("ProjectHandovers")
  projectWarranties         ProjectWarranty[]          @relation("ProjectWarranties")
  afterSalesServiceRequests AfterSalesServiceRequest[] @relation("ProjectAfterSalesServiceRequests")
  afterSalesServiceVisits   AfterSalesServiceVisit[]   @relation("ProjectAfterSalesServiceVisits")
  customerFeedbacks         CustomerFeedback[]         @relation("ProjectCustomerFeedbacks")
  retentionFollowUps        RetentionFollowUp[]        @relation("ProjectRetentionFollowUps")
  services                  ProjectService[]           @relation("ProjectServices")
  labourBookings            LabourBooking[]            @relation("ProjectLabourBookings")
  timelines                 ProjectTimeline[]          @relation("ProjectTimelines")
  payments                  ProjectPayment[]           @relation("ProjectPayments")

  @@unique([organizationId, projectCode])
  @@index([organizationId])
  @@index([customerId])
  @@index([leadId])
  @@index([serviceCategoryId])
  @@index([status])
  @@index([health])
  @@index([currentStage])
  @@index([priority])
  @@index([isDeleted, deletedAt])
  @@map("projects")
}

// ==========================================
// 2. PROJECT SITE & PHYSICAL LOCATION (1-to-1)
// ==========================================

model ProjectSite {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Site Location Details
  siteName String? @map("site_name") // e.g. "Prestige Lakeside, Tower 4, Flat 1202"
  address  String? @map("address")
  city     String? @map("city")
  state                 String?  @map("state")
  country               String   @default("IN") @map("country")
  pincode               String?  @map("pincode")
  gpsLat                Float?   @map("gps_lat")
  gpsLng                Float?   @map("gps_lng")
  punchRadiusMeters     Int      @default(200) @map("punch_radius_meters")
  isPunchGeofenceStrict Boolean  @default(true) @map("is_punch_geofence_strict")

  // Physical Specifications
  propertyType          String? @map("property_type") // e.g. "4BHK Villa", "Penthouse", "Commercial Office"
  floorNumber           String? @map("floor_number")
  totalAreaSqft         Float?  @map("total_area_sqft")
  workableAreaSqft      Float?  @map("workable_area_sqft")
  carpetAreaSqft        Float?  @map("carpet_area_sqft")

  // On-Site Point of Contact
  contactPerson         String? @map("contact_person")
  contactPersonRelation String? @map("contact_person_relation") // e.g. "Site Engineer", "Brother", "Supervisor", "Tenant"
  contactPhone          String? @map("contact_phone")
  contactEmail          String? @map("contact_email")
  accessInstructions    String? @map("access_instructions") @db.Text
  additionalInformation Json?   @map("additional_information")

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  labourAttendances LabourAttendance[] @relation("ProjectSiteLabourAttendances")

  @@index([city])
  @@map("project_sites")
}

// ==========================================
// 3. PROJECT DYNAMIC TEAM MEMBERS (1-to-Many)
// ==========================================

model ProjectMember {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Assigned Employee from HRMS
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("EmployeeProjectMembers", fields: [employeeId], references: [id], onDelete: Cascade)

  // Flexible Role & Responsibilities
  role             ProjectMemberRole @default(OTHER) @map("role")
  customRoleTitle  String?           @map("custom_role_title") // e.g. "Lead 3D Visualizer", "Acoustic Consultant"
  responsibilities String?           @map("responsibilities") @db.Text
  isPrimary        Boolean           @default(false) @map("is_primary") // e.g. Primary Project Manager
  isActive         Boolean           @default(true) @map("is_active")

  // Allocation & Timeline
  allocatedHoursPerWeek Float?    @map("allocated_hours_per_week")
  assignedAt            DateTime  @default(now()) @map("assigned_at")
  unassignedAt          DateTime? @map("unassigned_at")

  assignedById          String? @map("assigned_by_id") @db.Uuid
  assignedBy            User?   @relation("ProjectMemberAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  additionalInformation Json?   @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, employeeId, role])
  @@index([projectId])
  @@index([employeeId])
  @@index([role])
  @@index([isActive])
  @@map("project_members")
}

// ==========================================
// 4. PROJECT SCHEDULE & TIMELINE (1-to-1)
// ==========================================

model ProjectSchedule {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Key Dates
  plannedStartDate DateTime  @map("planned_start_date") @db.Date
  plannedEndDate   DateTime  @map("planned_end_date") @db.Date
  actualStartDate  DateTime? @map("actual_start_date") @db.Date
  actualEndDate    DateTime? @map("actual_end_date") @db.Date

  // Handover & Warranty Lifecycle
  kickoffDate             DateTime? @map("kickoff_date") @db.Date
  siteHandoverDate        DateTime? @map("site_handover_date") @db.Date
  warrantyStartDate       DateTime? @map("warranty_start_date") @db.Date
  warrantyEndDate         DateTime? @map("warranty_end_date") @db.Date
  extendedWarrantyEndDate DateTime? @map("extended_warranty_end_date") @db.Date

  // Duration Estimates
  estimatedDurationDays Int?  @map("estimated_duration_days")
  actualDurationDays    Int?  @map("actual_duration_days")
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([plannedStartDate, plannedEndDate])
  @@map("project_schedules")
}

// ==========================================
// 5. PROJECT PROGRESS & METRIC AGGREGATES (1-to-1)
// ==========================================

model ProjectMetric {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Percentage Metrics (0.00 to 100.00%)
  progressPercent     Float @default(0) @map("progress_percent")
  designProgress      Float @default(0) @map("design_progress")
  executionProgress   Float @default(0) @map("execution_progress")
  procurementProgress Float @default(0) @map("procurement_progress")
  paymentProgress     Float @default(0) @map("payment_progress")

  // Quality & Safety Audit Scores
  qualityScore Float? @map("quality_score") // 0 to 100
  safetyScore  Float? @map("safety_score") // 0 to 100

  lastEvaluatedAt       DateTime? @map("last_evaluated_at")
  additionalInformation Json?     @map("additional_information")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("project_metrics")
}

// ==========================================
// 6. PROJECT FINANCIALS & COMMERCIALS (1-to-1)
// ==========================================

model ProjectCommercial {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  currency String @default("INR") @map("currency")

  // Pricing Model Structure
  pricingModel ProjectPricingModel @default(TURNKEY_WITH_MATERIALS) @map("pricing_model")

  // Approved Contract Ceilings & Estimates
  contractAmount  Decimal @default(0) @map("contract_amount") @db.Decimal(14, 2)
  initialEstimate Decimal @default(0) @map("initial_estimate") @db.Decimal(14, 2)
  revisedEstimate Decimal @default(0) @map("revised_estimate") @db.Decimal(14, 2)

  // Commercial Head Allocations
  designFee       Decimal @default(0) @map("design_fee") @db.Decimal(14, 2)
  materialPayment Decimal @default(0) @map("material_payment") @db.Decimal(14, 2)
  labourPayment   Decimal @default(0) @map("labour_payment") @db.Decimal(14, 2)
  supervisionFee  Decimal @default(0) @map("supervision_fee") @db.Decimal(14, 2)

  // Consulting Model Parameters
  consultingPercentage Float?   @map("consulting_percentage") // e.g. 10.5%
  consultingLumpSum    Decimal? @map("consulting_lump_sum") @db.Decimal(14, 2)
  consultingRateSqft   Decimal? @map("consulting_rate_sqft") @db.Decimal(10, 2) // e.g. ₹150 / sqft
  billableAreaSqft     Float?   @map("billable_area_sqft")

  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_commercials")
}

// ==========================================
// 7. PROJECT MILESTONE (1-to-Many with Project)
// ==========================================

model ProjectMilestone {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectMilestones", fields: [projectId], references: [id], onDelete: Cascade)

  // Identity & Classification
  milestoneCode String          @map("milestone_code") // e.g. "MS-01", "MS-02"
  milestoneType MilestoneType   @default(EXECUTION) @map("milestone_type")
  name          String          @map("name") // e.g. "False Ceiling & Electrical Rough-in"
  description   String?         @map("description") @db.Text
  stage         ProjectStage    @default(EXECUTION) @map("stage")
  status        MilestoneStatus @default(NOT_STARTED) @map("status")
  priority      ProjectPriority @default(MEDIUM) @map("priority")
  orderIndex    Int             @default(0) @map("order_index") // Sequence sorting

  // Schedule & Progress
  startDate         DateTime  @map("planned_start_date") @db.Date
  dueDate           DateTime  @map("planned_due_date") @db.Date
  actualStartDate   DateTime? @map("actual_start_date") @db.Date
  completedAt       DateTime? @map("completed_at") @db.Date
  completionPercent Float     @default(0) @map("completion_percent") // 0.0 to 100.0

  // Personnel Ownership
  assigneeId String?   @map("assignee_id") @db.Uuid
  assignee   Employee? @relation("MilestoneAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Gates & Approvals
  approvalRequired Boolean  @default(false) @map("approval_required")
  paymentRequired  Boolean  @default(false) @map("payment_required")
  budgetAmount     Decimal? @map("budget_amount") @db.Decimal(14, 2)
  targetAmount     Decimal? @map("target_amount") @db.Decimal(14, 2)

  // Cloud Attachments (Array of ImageType JSON)
  attachments Json? @map("attachments")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  checklists      MilestoneChecklist[] @relation("MilestoneChecklists")
  progressEntries ProjectProgress[]    @relation("MilestoneProgressEntries")
  workApprovals   WorkApproval[]       @relation("MilestoneWorkApprovals")
  complaints      ProjectComplaint[]   @relation("MilestoneComplaints")
  siteVisits      ProjectSiteVisit[]   @relation("MilestoneSiteVisits")
  expenses        Expense[]            @relation("MilestoneExpenses")
  designs         ProjectDesign[]      @relation("MilestoneDesigns")
  payments        ProjectPayment[]     @relation("MilestonePayments")

  @@unique([projectId, milestoneCode])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([stage])
  @@index([milestoneType])
  @@index([orderIndex])
  @@index([isDeleted, deletedAt])
  @@map("project_milestones")
}

// ==========================================
// 8. PROJECT PAYMENT (History Ledger & Milestone Linkage)
// ==========================================

model ProjectPayment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationProjectPayments", fields: [organizationId], references: [id], onDelete: Cascade)

  // Project Association (Mandatory)
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectPayments", fields: [projectId], references: [id], onDelete: Cascade)

  // Optional Milestone Association
  milestoneId String?           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone? @relation("MilestonePayments", fields: [milestoneId], references: [id], onDelete: SetNull)

  // Client / Payer Reference
  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation("CustomerProjectPayments", fields: [customerId], references: [id], onDelete: SetNull)

  // Identification & Reference
  paymentNumber String @map("payment_number") // e.g. "PAY-PRJ-2026-001"
  title         String @map("title")          // e.g. "Advance 20% for 3D Concept Signoff"

  // Financial Classification
  paymentType   ProjectPaymentType   @default(TURNKEY_PACKAGE) @map("payment_type")
  flowDirection PaymentFlowDirection @default(INFLOW) @map("flow_direction")
  status        ProjectPaymentStatus @default(COMPLETED) @map("status")

  // Amount
  amount Decimal @map("amount") @db.Decimal(14, 2)

  // Payment Execution Details
  paymentDate          DateTime             @map("payment_date") @db.Date
  paymentMethod        ProjectPaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  transactionReference String?              @map("transaction_reference") // UTR / IMPS / Cheque #
  bankName             String?              @map("bank_name")

  // Recorded By / Verified By Personnel
  recordedById String?   @map("recorded_by_id") @db.Uuid
  recordedBy   Employee? @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  // Cloud Attachments (Receipts & Bank Acknowledgements)
  receiptUrl  Json? @map("receipt_url") // Structured ImageType JSON
  attachments Json? @map("attachments") // Array of ImageType JSON

  // Remarks & Additional Custom Information
  notes                 String? @map("notes") @db.Text
  additionalInformation Json?   @map("additional_information")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([customerId])
  @@index([paymentType])
  @@index([flowDirection])
  @@index([status])
  @@index([paymentDate])
  @@index([isDeleted, deletedAt])
  @@map("project_payments")
}

// ==========================================
// 8. MILESTONE CHECKLIST (1-to-Many with Milestone)
// ==========================================

model MilestoneChecklist {
  id          String           @id @default(uuid()) @db.Uuid
  milestoneId String           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone @relation("MilestoneChecklists", fields: [milestoneId], references: [id], onDelete: Cascade)

  title       String    @map("title") // e.g. "Verify conduit pressure test"
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  orderIndex  Int       @default(0) @map("order_index")
  dueDate     DateTime? @map("due_date") @db.Date

  assigneeId String?   @map("assignee_id") @db.Uuid
  assignee   Employee? @relation("ChecklistAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([milestoneId])
  @@index([isCompleted])
  @@map("milestone_checklists")
}

// ==========================================
// 9. PROJECT PROGRESS (Site Logs / Daily Field Updates)
// ==========================================

model ProjectProgress {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectProgressEntries", fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone? @relation("MilestoneProgressEntries", fields: [milestoneId], references: [id], onDelete: SetNull)

  // Physical Location & Work Category
  areaRoom  String? @map("area_room") // e.g. "Master Bedroom", "Kitchen", "Living Area"
  workStage String? @map("work_stage") // e.g. "Carpentry", "Electrical Rough-in", "Tile Laying"

  // Date & Percentage
  progressDate    DateTime @map("progress_date") @db.Date
  progressPercent Float    @default(0) @map("progress_percent") // e.g. 75.0%

  // Work Accomplished & Blockers
  description   String? @map("description") @db.Text
  workCompleted String? @map("work_completed") @db.Text
  workPending   String? @map("work_pending") @db.Text
  issues        String? @map("issues") @db.Text
  nextAction    String? @map("next_action") @db.Text

  // Cloud Media Attachments (Photos, Videos, Inspections: Array of ImageType JSON)
  media Json? @map("media")

  // Visibility & Verification Workflow
  visibility     ProgressVisibility     @default(INTERNAL) @map("visibility")
  approvalStatus ProgressApprovalStatus @default(SUBMITTED) @map("approval_status")

  // Personnel Submission & Review
  submittedById String?   @map("submitted_by_id") @db.Uuid
  submittedBy   Employee? @relation("ProgressSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedBy      Employee? @relation("ProgressApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason") @db.Text

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([milestoneId])
  @@index([progressDate])
  @@index([approvalStatus])
  @@index([visibility])
  @@index([isDeleted, deletedAt])
  @@map("project_progress")
}

// ==========================================
// 10. WORK APPROVAL (Client Sign-Offs & Change Requests)
// ==========================================

model WorkApproval {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectWorkApprovals", fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone? @relation("MilestoneWorkApprovals", fields: [milestoneId], references: [id], onDelete: SetNull)

  // Identity & Classification
  title       String          @map("title") // e.g. "Kitchen Cabinets & Quartz Countertop Finish"
  description String?         @map("description") @db.Text
  type        ApprovalType    @default(DESIGN) @map("type")
  status      ApprovalStatus  @default(PENDING) @map("status")
  priority    ProjectPriority @default(MEDIUM) @map("priority")

  // Submission & Workflow
  submittedById String?   @map("submitted_by_id") @db.Uuid
  submittedBy   Employee? @relation("WorkApprovalSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  dueDate       DateTime? @map("due_date") @db.Date // Target deadline for client signoff

  // Client Decision & Change Request Lifecycle
  reviewedAt      DateTime? @map("reviewed_at")
  clientFeedback  String?   @map("client_feedback") @db.Text // Overall client response
  revisionNotes   String?   @map("revision_notes") @db.Text // Specific change requests / tweaks requested
  revisionCount   Int       @default(0) @map("revision_count") // Tracks revision rounds
  rejectionReason String?   @map("rejection_reason") @db.Text

  // Cloud Attachments (Array of ImageType JSON: drawings, 3D renders, spec sheets)
  attachments Json? @map("attachments")

  // Client Portal Settings
  isClientPortalVisible Boolean @default(true) @map("is_client_portal_visible")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Change Requests Lifecycle (1-to-Many)
  changeRequests WorkApprovalChangeRequest[] @relation("WorkApprovalChangeRequests")

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
  @@index([type])
  @@index([submittedById])
  @@index([isDeleted, deletedAt])
  @@map("work_approvals")
}

// ==========================================
// 11. WORK APPROVAL CHANGE REQUEST (Client Modification Rounds)
// ==========================================

model WorkApprovalChangeRequest {
  id             String       @id @default(uuid()) @db.Uuid
  workApprovalId String       @map("work_approval_id") @db.Uuid
  workApproval   WorkApproval @relation("WorkApprovalChangeRequests", fields: [workApprovalId], references: [id], onDelete: Cascade)

  // Iteration / Revision sequence
  roundNumber Int     @default(1) @map("round_number")
  title       String? @map("title")

  // Client Request Details
  requestedChanges String              @map("requested_changes") @db.Text // Specific modifications demanded
  reason           String?             @map("reason") @db.Text // Context / rationale
  status           ChangeRequestStatus @default(PENDING) @map("status")

  // Client Attribution & Media
  requestedByCustomerId String?   @map("requested_by_customer_id") @db.Uuid
  requestedByCustomer   Customer? @relation("CustomerChangeRequests", fields: [requestedByCustomerId], references: [id], onDelete: SetNull)
  requestedAt           DateTime  @default(now()) @map("requested_at")
  attachments           Json?     @map("attachments") // Client markup images / reference sketches (ImageType JSON array)

  // Organization Response & Resolution
  responseNotes      String?   @map("response_notes") @db.Text // Team feedback or explanation of revisions
  respondedById      String?   @map("responded_by_id") @db.Uuid
  respondedBy        Employee? @relation("ChangeRequestRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt        DateTime? @map("responded_at")
  revisedAttachments Json?     @map("revised_attachments") // Updated drawings/renders uploaded in response

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workApprovalId])
  @@index([status])
  @@index([requestedByCustomerId])
  @@index([respondedById])
  @@map("work_approval_change_requests")
}

// ==========================================
// 12. PROJECT COMPLAINT (Issues & Snags Tracking)
// ==========================================

model ProjectComplaint {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectComplaints", fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone? @relation("MilestoneComplaints", fields: [milestoneId], references: [id], onDelete: SetNull)

  // Identity & Classification
  title       String                 @map("title") // e.g. "Misaligned tile grout in master bathroom"
  description String                 @map("description") @db.Text
  type        ComplaintType          @default(QUALITY) @map("type")
  categoryId  String?                @map("category_id") @db.Uuid
  categoryRef ComplaintSnagCategory? @relation("ComplaintCategoryRelation", fields: [categoryId], references: [id], onDelete: SetNull)
  status      ComplaintStatus        @default(OPEN) @map("status")
  severity    ComplaintSeverity      @default(MEDIUM) @map("severity")
  priority    ProjectPriority        @default(MEDIUM) @map("priority")

  // Site Location Context
  areaRoom String? @map("area_room") // e.g. "Master Bedroom", "Kitchen"

  // Reporter Attribution
  reportedByCustomerId String?   @map("reported_by_customer_id") @db.Uuid
  reportedByCustomer   Customer? @relation("CustomerReportedComplaints", fields: [reportedByCustomerId], references: [id], onDelete: SetNull)

  reportedByEmployeeId String?   @map("reported_by_employee_id") @db.Uuid
  reportedByEmployee   Employee? @relation("EmployeeReportedComplaints", fields: [reportedByEmployeeId], references: [id], onDelete: SetNull)

  reportedAt DateTime @default(now()) @map("reported_at")

  // Assignment & Resolution Lifecycle
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  assignedTo   Employee? @relation("EmployeeAssignedComplaints", fields: [assignedToId], references: [id], onDelete: SetNull)

  targetResolutionDate DateTime? @map("target_resolution_date") @db.Date
  resolvedAt           DateTime? @map("resolved_at")
  resolvedById         String?   @map("resolved_by_id") @db.Uuid
  resolvedBy           Employee? @relation("EmployeeResolvedComplaints", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes      String?   @map("resolution_notes") @db.Text

  closedAt        DateTime? @map("closed_at")
  rejectionReason String?   @map("rejection_reason") @db.Text

  // Cloud Attachments (Photos/Videos of defect & proof of rectification: ImageType JSON array)
  attachments           Json? @map("attachments")
  additionalInformation Json? @map("additional_information")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Discussion & Feedback Thread
  comments      ComplaintComment[]    @relation("ComplaintComments")
  handoverSnags ProjectHandoverSnag[] @relation("ComplaintHandoverSnags")

  @@index([projectId])
  @@index([categoryId])
  @@index([milestoneId])
  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([priority])
  @@index([assignedToId])
  @@index([reportedByCustomerId])
  @@index([isDeleted, deletedAt])
  @@map("project_complaints")
}

// ==========================================
// 13. COMPLAINT COMMENT (Activity & Chat Thread)
// ==========================================

model ComplaintComment {
  id          String           @id @default(uuid()) @db.Uuid
  complaintId String           @map("complaint_id") @db.Uuid
  complaint   ProjectComplaint @relation("ComplaintComments", fields: [complaintId], references: [id], onDelete: Cascade)

  authorType String    @map("author_type") // "CUSTOMER" or "EMPLOYEE"
  userId     String?   @map("user_id") @db.Uuid
  user       User?     @relation("ComplaintCommentUser", fields: [userId], references: [id], onDelete: SetNull)
  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation("ComplaintCommentEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  message     String @map("message") @db.Text
  attachments Json?  @map("attachments") // ImageType JSON array

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([complaintId])
  @@index([createdAt])
  @@map("complaint_comments")
}

// ==========================================
// 14. PROJECT SITE VISIT (Field Surveys & Inspections)
// ==========================================

model ProjectSiteVisit {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectSiteVisits", fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone? @relation("MilestoneSiteVisits", fields: [milestoneId], references: [id], onDelete: SetNull)

  // Identity & Classification
  title     String            @map("title") // e.g. "False Ceiling Framing & Electrical Conduit Check"
  visitType SiteVisitType     @default(EXECUTION) @map("visit_type")
  status    SiteVisitStatus   @default(SCHEDULED) @map("status")
  outcome   SiteVisitOutcome? @map("outcome")

  // Schedule & Timing
  plannedDate DateTime  @map("planned_date") @db.Date
  actualDate  DateTime? @map("actual_date") @db.Date
  startTime   String?   @map("start_time") // e.g. "10:30 AM"
  endTime     String?   @map("end_time") // e.g. "12:00 PM"

  // Purpose, Observations & Actions
  purpose          String? @map("purpose") @db.Text
  summary          String? @map("summary") @db.Text // Observations / work inspected
  issuesIdentified String? @map("issues_identified") @db.Text // Snags & defects identified
  actionItems      String? @map("action_items") @db.Text // Next actions / contractor instructions

  // Attendees & Location
  visitorEmployeeId    String?   @map("visitor_employee_id") @db.Uuid
  visitorEmployee      Employee? @relation("SiteVisitVisitor", fields: [visitorEmployeeId], references: [id], onDelete: SetNull)
  clientRepresentative String?   @map("client_representative") // Name of client / representative met
  locationGpsLat       Float?    @map("location_gps_lat")
  locationGpsLng       Float?    @map("location_gps_lng")

  // Cloud Attachments (Site inspection photos, videos, sketches: ImageType JSON array)
  attachments Json? @map("attachments")

  // Client Portal Settings
  isClientPortalVisible Boolean @default(true) @map("is_client_portal_visible")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([milestoneId])
  @@index([visitorEmployeeId])
  @@index([visitType])
  @@index([status])
  @@index([plannedDate])
  @@index([isDeleted, deletedAt])
  @@map("project_site_visits")
}

// ==========================================
// 15. EXPENSE CATEGORY (Dynamic Organization Master)
// ==========================================

model ExpenseCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationExpenseCategories", fields: [organizationId], references: [id], onDelete: Cascade)

  // Classification & Naming
  name        String       @map("name") // e.g. "Raw Materials", "Site Labour", "Software & Tools", "Office Rent"
  slug        String       @map("slug") // e.g. "raw-materials", "site-labour", "office-rent"
  code        String?      @map("code") // Optional GL / Accounting Code (e.g. "5100", "EXP-MAT-01")
  description String?      @map("description") @db.Text
  scope       ExpenseScope @default(PROJECT) @map("scope") // Applicable to PROJECT, ORGANIZATION, or BOTH

  // UI Theming & Visuals
  color String? @map("color") // Hex badge color (e.g. "#6366F1")
  icon  String? @map("icon") // Lucide icon identifier (e.g. "Package", "Wrench", "Building2")

  // Tax & Accounting Metadata
  isTaxDeductible Boolean @default(true) @map("is_tax_deductible") // Whether this category qualifies for tax deduction
  isDefault       Boolean @default(false) @map("is_default") // System pre-seeded default category vs custom created
  isActive        Boolean @default(true) @map("is_active")

  // Associated Expenses Relation
  expenses Expense[] @relation("CategoryExpenses")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([organizationId, scope])
  @@index([isDeleted, deletedAt])
  @@map("expense_categories")
}

// ==========================================
// 16. EXPENSE (Project & Organization Financials)
// ==========================================

model Expense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationExpenses", fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional Project & Milestone Association (Null = General Organization Overhead)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("ProjectExpenses", fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?           @map("milestone_id") @db.Uuid
  milestone   ProjectMilestone? @relation("MilestoneExpenses", fields: [milestoneId], references: [id], onDelete: SetNull)

  // Optional Vendor / Supplier Linkage
  vendorId String? @map("vendor_id") @db.Uuid
  vendor   Vendor? @relation("VendorExpenses", fields: [vendorId], references: [id], onDelete: SetNull)

  // Scope & Dynamic Category Linkage
  title        String           @map("title") // e.g. "Italian Marble 450 sqft purchase" or "Office Studio Rent - Oct 2026"
  description  String?          @map("description") @db.Text
  expenseScope ExpenseScope     @default(PROJECT) @map("expense_scope")
  categoryId   String?          @map("category_id") @db.Uuid
  category     ExpenseCategory? @relation("CategoryExpenses", fields: [categoryId], references: [id], onDelete: SetNull)

  // Financial Figures
  amount      Decimal @map("amount") @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(14, 2)
  currency    String  @default("INR") @map("currency")

  // Payment Timeline & Mode
  expenseDate   DateTime             @map("expense_date") @db.Date
  paymentMethod ExpensePaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  paymentStatus ExpensePaymentStatus @default(PAID) @map("payment_status")
  paidAt        DateTime?            @map("paid_at")

  // Billing & Invoicing Reference
  invoiceNumber        String? @map("invoice_number")
  transactionReference String? @map("transaction_reference") // UTR / Cheque / Bank Ref No

  // Personnel Attribution
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   Employee? @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Cloud Attachments & Receipts
  receiptUrl  Json? @map("receipt_url") // Primary invoice / receipt copy (ImageType JSON)
  attachments Json? @map("attachments") // Additional delivery challans / PO slips (ImageType JSON array)

  // Billing & Reimbursement Flags
  isBillableToClient Boolean @default(false) @map("is_billable_to_client") // True if billed to client as variation / reimbursable
  isReimbursable     Boolean @default(false) @map("is_reimbursable") // True if paid out-of-pocket by employee
  isReimbursed       Boolean @default(false) @map("is_reimbursed")

  // Custom Tags & Notes
  notes String?  @map("notes") @db.Text
  tags  String[] @default([]) @map("tags")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([vendorId])
  @@index([expenseScope])
  @@index([categoryId])
  @@index([paymentStatus])
  @@index([expenseDate])
  @@index([createdById])
  @@index([isDeleted, deletedAt])
  @@map("expenses")
}

// ==========================================
// 17. PROJECT HANDOVER (Formal Site Handover & Possession)
// ==========================================

model ProjectHandover {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationProjectHandovers", fields: [organizationId], references: [id], onDelete: Cascade)

  // Project & Client Association
  projectId  String   @map("project_id") @db.Uuid
  project    Project  @relation("ProjectHandovers", fields: [projectId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation("CustomerProjectHandovers", fields: [customerId], references: [id], onDelete: Restrict)

  // Handover Identity & Status
  handoverNumber String                @map("handover_number") // e.g. "HND-2026-0001"
  title          String                @map("title") // e.g. "Villa Grandeur 4BHK Final Handover & Possession"
  description    String?               @map("description") @db.Text
  status         ProjectHandoverStatus @default(DRAFT) @map("status")

  // Timeline
  scheduledDate DateTime? @map("scheduled_date") @db.Date // Planned client walkthrough & key handover
  inspectedDate DateTime? @map("inspected_date") @db.Date // Actual joint inspection date
  handoverDate  DateTime? @map("handover_date") @db.Date // Actual key possession date

  // Commercial & Financial Settlement Clearance
  isCommercialCleared   Boolean  @default(false) @map("is_commercial_cleared")
  finalSettlementAmount Decimal? @map("final_settlement_amount") @db.Decimal(14, 2)
  pendingAmount         Decimal? @default(0) @map("pending_amount") @db.Decimal(14, 2)
  commercialRemarks     String?  @map("commercial_remarks") @db.Text

  // Warranty & Defect Liability Period (DLP)
  warrantyPeriodMonths Int?      @default(12) @map("warranty_period_months")
  warrantyStartDate    DateTime? @map("warranty_start_date") @db.Date
  warrantyEndDate      DateTime? @map("warranty_end_date") @db.Date
  warrantyTerms        String?   @map("warranty_terms") @db.Text
  warrantyDocumentUrl  Json?     @map("warranty_document_url") // ImageType structured JSON

  // Formal Handover Execution & Client Acceptance
  handedOverById         String?   @map("handed_over_by_id") @db.Uuid
  handedOverBy           Employee? @relation("EmployeeHandedOverProjects", fields: [handedOverById], references: [id], onDelete: SetNull)
  clientSignoffName      String?   @map("client_signoff_name") // Name of client / authorized POA representative
  clientSignedAt         DateTime? @map("client_signed_at")
  clientSignatureUrl     Json?     @map("client_signature_url") // Digital touch signature (ImageType JSON)
  clientFeedback         String?   @map("client_feedback") @db.Text // Client testimonials / remarks
  clientRating           Float?    @map("client_rating") // 1.0 to 5.0 CSAT rating
  handoverCertificateUrl Json?     @map("handover_certificate_url") // Final PDF sign-off sheet (ImageType JSON)
  sitePhotos             Json?     @map("site_photos") // Finished walkthrough site photos (ImageType JSON array)

  // Universal Custom Fields & Metadata
  additionalInformation Json? @map("additional_information")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Child Relations
  items      ProjectHandoverItem[] @relation("HandoverItems")
  snags      ProjectHandoverSnag[] @relation("HandoverSnags")
  warranties ProjectWarranty[]     @relation("HandoverWarranties")

  @@unique([organizationId, handoverNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([customerId])
  @@index([status])
  @@index([handedOverById])
  @@index([handoverDate])
  @@index([isDeleted, deletedAt])
  @@map("project_handovers")
}

// ==========================================
// 18. PROJECT HANDOVER ITEM (Deliverables, Keys & Manuals Checklist)
// ==========================================

model ProjectHandoverItem {
  id         String          @id @default(uuid()) @db.Uuid
  handoverId String          @map("handover_id") @db.Uuid
  handover   ProjectHandover @relation("HandoverItems", fields: [handoverId], references: [id], onDelete: Cascade)

  category      HandoverItemCategory @default(KEYS) @map("category")
  name          String               @map("name") // e.g. "Main Door Smart Lock RFID Cards (x3)"
  description   String?              @map("description") @db.Text
  quantity      Int                  @default(1) @map("quantity")
  unit          String?              @default("PCS") @map("unit") // PCS, SET, ROLL, CAN, FILE
  status        HandoverItemStatus   @default(PENDING) @map("status")
  handedOverAt  DateTime?            @map("handed_over_at")
  recipientName String?              @map("recipient_name")
  documentUrl   Json?                @map("document_url") // ImageType JSON (PDF manual / warranty photo)
  notes         String?              @map("notes") @db.Text

  // Universal Custom Fields & Metadata
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([handoverId])
  @@index([category])
  @@index([status])
  @@map("project_handover_items")
}

// ==========================================
// 19. PROJECT HANDOVER SNAG (Punch-List & Pre-Handover Rectification)
// ==========================================

model ProjectHandoverSnag {
  id         String          @id @default(uuid()) @db.Uuid
  handoverId String          @map("handover_id") @db.Uuid
  handover   ProjectHandover @relation("HandoverSnags", fields: [handoverId], references: [id], onDelete: Cascade)

  // Optional linkage to existing ProjectComplaint ticket
  complaintId String?           @map("complaint_id") @db.Uuid
  complaint   ProjectComplaint? @relation("ComplaintHandoverSnags", fields: [complaintId], references: [id], onDelete: SetNull)

  // Linkage to Master Snag Category
  categoryId  String?                @map("category_id") @db.Uuid
  categoryRef ComplaintSnagCategory? @relation("SnagCategoryRelation", fields: [categoryId], references: [id], onDelete: SetNull)

  areaRoom    String?              @map("area_room") // e.g. "Living Room", "Master Bathroom"
  title       String               @map("title") // e.g. "Touch-up paint behind sofa wall"
  description String?              @map("description") @db.Text
  severity    HandoverSnagSeverity @default(LOW) @map("severity")
  status      HandoverSnagStatus   @default(REPORTED) @map("status")

  // Assigned Trade Specialist / Employee
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  assignedTo   Employee? @relation("EmployeeAssignedHandoverSnags", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Resolution Tracking
  targetResolutionDate DateTime? @map("target_resolution_date") @db.Date
  resolvedAt           DateTime? @map("resolved_at")
  resolvedNotes        String?   @map("resolved_notes") @db.Text

  // Photographic Evidence (ImageType JSON)
  beforePhotoUrl Json? @map("before_photo_url")
  afterPhotoUrl  Json? @map("after_photo_url")

  // Universal Custom Fields & Metadata
  additionalInformation Json? @map("additional_information")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([handoverId])
  @@index([complaintId])
  @@index([categoryId])
  @@index([status])
  @@index([severity])
  @@index([assignedToId])
  @@map("project_handover_snags")
}

// ==========================================
// 27. PROJECT TIMELINE ENUMS & MODEL (Full Project Lifecycle & Custom Events)
// ==========================================

enum ProjectTimelineEventType {
  PROJECT_CREATED        // Project onboarding & creation
  STAGE_CHANGED          // Moved across project stages
  STATUS_CHANGED         // Status update (Design / Execution / General)
  HEALTH_CHANGED         // Health status update
  SITE_VISIT             // Site survey or audit visit performed
  MILESTONE_STARTED      // Milestone kickoff
  MILESTONE_COMPLETED    // Milestone completion & verification
  WORK_APPROVAL          // Client drawing / design sign-off
  PROGRESS_UPDATE        // Daily/weekly site progress entry
  COMMERCIAL_INVOICE     // Payment milestone / commercial update
  HANDOVER_SNAG          // Handover inspection / snag item
  CUSTOM_EVENT           // Custom user-defined timeline event
  OTHER                  // Miscellaneous event
}

enum ProjectTimelineStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

model ProjectTimeline {
  id                    String                   @id @default(uuid()) @db.Uuid
  projectId             String                   @map("project_id") @db.Uuid
  project               Project                  @relation("ProjectTimelines", fields: [projectId], references: [id], onDelete: Cascade)

  // Event & Timeline Details
  title                 String                   @map("title") // e.g. "Project Created", "Site Measurement Survey Completed", "False Ceiling Finished"
  description           String?                  @map("description") @db.Text
  eventType             ProjectTimelineEventType @default(CUSTOM_EVENT) @map("event_type")
  category              String?                  @map("category") // e.g. "DESIGN", "EXECUTION", "SITE_VISIT", "HANDOVER", "FINANCIAL"
  status                ProjectTimelineStatus    @default(COMPLETED) @map("status")
  eventDate             DateTime                 @default(now()) @map("event_date")
  orderIndex            Int                      @default(0) @map("order_index")

  // Creator / Performer Attribution
  performedById         String?                  @map("performed_by_id") @db.Uuid
  performedBy           Employee?                @relation("EmployeeProjectTimelineEvents", fields: [performedById], references: [id], onDelete: SetNull)
  createdById           String?                  @map("created_by_id") @db.Uuid
  createdBy             User?                    @relation("UserProjectTimelineCreated", fields: [createdById], references: [id], onDelete: SetNull)

  // Custom vs System Generated Flags
  isCustom              Boolean                  @default(true) @map("is_custom")
  isSystemGenerated     Boolean                  @default(false) @map("is_system_generated")

  // Cloud Attachments & Media (ImageType JSON array)
  attachments           Json?                    @map("attachments")
  metadata              Json?                    @map("metadata")
  additionalInformation Json?                    @map("additional_information")

  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([eventDate])
  @@index([eventType])
  @@index([isCustom])
  @@map("project_timelines")
}
