// ==========================================
// TASK ENUMS
// ==========================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  RE_WORK
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskType {
  FOLLOW_UP
  SITE_MEASUREMENT
  DESIGN_DRAFT
  QUOTATION_PREP
  MATERIAL_SELECTION
  CLIENT_REVIEW
  PROJECT_MILESTONE
  SITE_INSPECTION
  DOCUMENT_VERIFICATION
  PAYMENT_FOLLOWUP
  GENERAL
  OTHER
}

// ==========================================
// TASK MODEL (Polymorphic: Lead, Project)
// ==========================================

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationTasks", fields: [organizationId], references: [id], onDelete: Cascade)

  // Unique Human-Readable Task Code
  taskCode String @map("task_code") // e.g. "TASK-2026-0001"

  // Polymorphic Associations
  // 1. Lead Association (Optional)
  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation("LeadTasks", fields: [leadId], references: [id], onDelete: SetNull)

  // 2. Project Association (Future-proof for Project Management module)
  projectId String? @map("project_id") @db.Uuid

  // Task Information
  title       String       @map("title")
  description String?      @map("description")
  type        TaskType     @default(GENERAL) @map("type")
  priority    TaskPriority @default(MEDIUM) @map("priority")
  status      TaskStatus   @default(TODO) @map("status")

  // Checklist & Progress Metrics (e.g. 2/10 completed = 20%)
  checklistTotal     Int   @default(0) @map("checklist_total")
  checklistCompleted Int   @default(0) @map("checklist_completed")
  progressPercentage Float @default(0) @map("progress_percentage")
  checklist          Json? @map("checklist") // Array of { id: string, title: string, isCompleted: boolean }

  // Scheduling & Deadlines
  startDate            DateTime? @map("start_date")
  dueDate              DateTime? @map("due_date")
  submittedForReviewAt DateTime? @map("submitted_for_review_at") // Recorded when task is submitted under review
  completedAt          DateTime? @map("completed_at")           // Recorded when verified and marked completed

  // Task Review & Verification Approval
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedBy      Employee? @relation("TaskApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime? @map("approved_at")
  approvalRemarks String?   @map("approval_remarks")

  // Estimation & Time Tracking
  estimatedHours Float? @map("estimated_hours")
  actualHours    Float? @map("actual_hours")

  // Primary Lead / Owner (Optional direct reference alongside multi-assignees)
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  assignedTo   Employee? @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Dynamic Task Category Master
  categoryId String?       @map("category_id") @db.Uuid
  category   TaskCategory? @relation("TaskCategoryRelation", fields: [categoryId], references: [id], onDelete: SetNull)

  // Reminders
  remindAt       DateTime? @map("remind_at")
  isReminderSent Boolean   @default(false) @map("is_reminder_sent")

  // Metadata & Custom Attributes
  tags                  String[] @default([]) @map("tags")
  notes                 String?  @map("notes")
  customFields          Json?    @map("custom_fields")
  additionalInformation Json?    @map("additional_information")

  // Soft Delete & Timestamps
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  assignees      TaskAssignee[]      @relation("TaskAssignees")
  checklistItems TaskChecklistItem[] @relation("TaskChecklistItems")
  activities     TaskActivity[]      @relation("TaskActivities")
  documents      TaskDocument[]      @relation("TaskDocuments")

  @@unique([organizationId, taskCode])
  @@index([organizationId])
  @@index([leadId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([approvedById])
  @@index([categoryId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isDeleted, deletedAt])
  @@map("tasks")
}

// ==========================================
// TASK ASSIGNEES (Multi-Employee Task Assignment Mapping)
// ==========================================

model TaskAssignee {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationTaskAssignees", fields: [organizationId], references: [id], onDelete: Cascade)

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation("TaskAssignees", fields: [taskId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("EmployeeTaskAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  isPrimary    Boolean  @default(false) @map("is_primary")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedBy   User?    @relation("TaskAssigneeAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([taskId, employeeId])
  @@index([organizationId])
  @@index([taskId])
  @@index([employeeId])
  @@map("task_assignees")
}

// ==========================================
// TASK CHECKLIST / SUBTASKS
// ==========================================

model TaskChecklistItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationTaskChecklists", fields: [organizationId], references: [id], onDelete: Cascade)

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation("TaskChecklistItems", fields: [taskId], references: [id], onDelete: Cascade)

  title       String    @map("title")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  sortOrder   Int       @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([taskId])
  @@map("task_checklist_items")
}

// ==========================================
// TASK ACTIVITY & COMMENTS LOG
// ==========================================

model TaskActivity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationTaskActivities", fields: [organizationId], references: [id], onDelete: Cascade)

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation("TaskActivities", fields: [taskId], references: [id], onDelete: Cascade)

  type          String    @map("type") // COMMENT, STATUS_CHANGE, ASSIGNMENT, PRIORITY_CHANGE, NOTE
  content       String    @map("content")
  performedById String?   @map("performed_by_id") @db.Uuid
  performedBy   Employee? @relation("TaskActivityPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  metadata      Json?     @map("metadata")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([taskId])
  @@index([performedById])
  @@map("task_activities")
}

// ==========================================
// TASK DOCUMENTS & ATTACHMENTS
// ==========================================

model TaskDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation("OrganizationTaskDocuments", fields: [organizationId], references: [id], onDelete: Cascade)

  taskId String @map("task_id") @db.Uuid
  task   Task   @relation("TaskDocuments", fields: [taskId], references: [id], onDelete: Cascade)

  name         String   @map("name")
  fileUrl      Json     @map("file_url") // ImageType structured JSON
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?    @relation("TaskDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([taskId])
  @@map("task_documents")
}
